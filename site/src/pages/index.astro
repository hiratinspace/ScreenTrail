  <section class="stack wrap" id="stack" aria-labelledby="h-stack">
    <h2 id="h-stack">Fits the stack you already run.</h2>
    <p class="sub mt">It starts on its own in the remote tool your technicians open, and publishes into the PSA and documentation you already use.</p>
    <div class="flow">
      <h3 class="flow-h in">Starts in</h3>
      <h3 class="flow-h core">Runs on</h3>
      <h3 class="flow-h out">Publishes to</h3>
      <ul class="flow-list in">
        <li><span class="fi"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="1.75" y="2.5" width="12.5" height="8.5" rx="1.5"/><path d="M5.5 13.5h5M8 11v2.5" stroke-linecap="round"/></svg></span><span>ScreenConnect</span></li>
        <li><span class="fi"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="1.75" y="2.5" width="12.5" height="8.5" rx="1.5"/><path d="M5.5 13.5h5M8 11v2.5" stroke-linecap="round"/></svg></span><span>Splashtop</span></li>
        <li><span class="fi"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="1.75" y="2.5" width="12.5" height="8.5" rx="1.5"/><path d="M5.5 13.5h5M8 11v2.5" stroke-linecap="round"/></svg></span><span>Remote Desktop</span></li>
        <li><span class="fi"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="1.75" y="2.5" width="12.5" height="8.5" rx="1.5"/><path d="M5.5 13.5h5M8 11v2.5" stroke-linecap="round"/></svg></span><span>TeamViewer</span></li>
        <li><span class="fi"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="1.75" y="2.5" width="12.5" height="8.5" rx="1.5"/><path d="M5.5 13.5h5M8 11v2.5" stroke-linecap="round"/></svg></span><span>AnyDesk</span></li>
      </ul>
      <svg class="wires in" viewBox="0 0 100 320" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M0 28 C 55 28, 45 160, 100 160"/><path d="M0 94 C 55 94, 45 160, 100 160"/><path d="M0 160 C 55 160, 45 160, 100 160"/><path d="M0 226 C 55 226, 45 160, 100 160"/><path d="M0 292 C 55 292, 45 160, 100 160"/></svg>
      <div class="flow-core">
        <img src={mark.src} alt="" width="44" height="44" />
        <p class="flow-name">ScreenTrail</p>
        <ul>
          <li>Windows<small>desktop app</small></li>
          <li>Gemini or Claude<small>drafting model</small></li>
        </ul>
      </div>
      <svg class="wires out" viewBox="0 0 100 320" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M0 160 C 55 160, 45 36.25, 100 36.25"/><path d="M0 160 C 55 160, 45 118.75, 100 118.75"/><path class="later" d="M0 160 C 55 160, 45 201.25, 100 201.25"/><path class="later" d="M0 160 C 55 160, 45 283.75, 100 283.75"/></svg>
      <ul class="flow-list out">
        <li><span class="fi"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M2 4.5A1.5 1.5 0 0 1 3.5 3h9A1.5 1.5 0 0 1 14 4.5v1.75a1.75 1.75 0 0 0 0 3.5v1.75A1.5 1.5 0 0 1 12.5 13h-9A1.5 1.5 0 0 1 2 11.5V9.75a1.75 1.75 0 0 0 0-3.5z"/><path d="M6 6.5h4M6 9.5h3" stroke-linecap="round"/></svg></span><span>ConnectWise PSA<small>note and time entry</small></span></li>
        <li><span class="fi"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M3 2.75h7.5a1.5 1.5 0 0 1 1.5 1.5v9.25H4.5A1.5 1.5 0 0 1 3 12z"/><path d="M3 12a1.5 1.5 0 0 1 1.5-1.5H12M6 5.5h3.5" stroke-linecap="round"/></svg></span><span>Hudu<small>KB article</small></span></li>
        <li class="later"><span class="fi"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M2 4.5A1.5 1.5 0 0 1 3.5 3h9A1.5 1.5 0 0 1 14 4.5v1.75a1.75 1.75 0 0 0 0 3.5v1.75A1.5 1.5 0 0 1 12.5 13h-9A1.5 1.5 0 0 1 2 11.5V9.75a1.75 1.75 0 0 0 0-3.5z"/><path d="M6 6.5h4M6 9.5h3" stroke-linecap="round"/></svg></span><span>HaloPSA<small>planned</small></span></li>
