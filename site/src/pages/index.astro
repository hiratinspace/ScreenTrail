---
/**
 * The home page, ported from the approved draft (artifact 740bacdb). The copy is held to the product as
 * built (docs/STATUS.md, checked 2026-11-18): no absolute redaction claims, no results before the pilot,
 * and the owner connects the PSA. Animated parts are drawn by src/scripts/home.ts; without it the page is
 * complete and still.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MaskBand from '../components/MaskBand.astro';
import '../styles/home.css';
import glyphLight from '../assets/brand/glyph-small-light.svg';
import glyphDark from '../assets/brand/glyph-small-dark.svg';
import mark from '../assets/brand/mark-primary-on-white.svg';
import review from '../assets/screens/review.png';
import receipt from '../assets/screens/detail-receipt.png';
import sessions from '../assets/screens/detail-sessions.png';
import settings from '../assets/screens/detail-settings.png';
import panel from '../assets/screens/panel.png';
import { site } from '../site.config';
import { choices, limits } from '../../worker/pilot';

// The pinned scene's wall: a week of 46 sessions, Monday to Friday, each day's sessions in time order.
// Red tiles are the notes that never got written. The week ends on Friday's #48213 at 13:54, the
// session the timeline below tells. Each session has a start and a length in minutes; home.ts places it
// on the calendar.
const bad: Record<number, [string, string]> = {
  4: ['Note', '"Fixed it."'],
  9: ['No time entry', '0:40 not billed'],
  15: ['Written later', '6 h after the call'],
  20: ['Screenshot', 'password visible'],
  26: ['No note', 'fix lives in one head'],
  31: ['Note', '"Rebooted, ok now."'],
  37: ['No time entry', '1:15 not billed'],
  42: ['No note', 'escalated blind'],
};
const dayNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
// What each session was about: the topic of the note ScreenTrail writes for it. The week's last is #48213.
const topics = ['VPN reconnect', 'MFA reset', 'New user setup', 'Disk full', 'Wi-Fi drops', 'Drive access', 'Teams audio', 'Password reset', 'Laptop setup', 'Backup failed', 'Slow PC', 'Scan to email', 'License assigned', 'Mailbox rules', 'Driver update', 'Outlook profile', 'Firewall rule', 'App crash', 'Monitor setup', 'Cert warning', 'Phone pairing', 'Calendar sharing', 'Printer queue'];
const perDay = [10, 9, 9, 9, 9];
const hhmm = (m: number) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
let n = 0;
const days = perDay.map((count, d) => {
  const start = 8 * 60 + 5 + ((d * 17) % 25);
  const end = d === 4 ? 13 * 60 + 54 : 16 * 60 + 40 - ((d * 23) % 30);
  const tiles = Array.from({ length: count }, (_, k) => {
    const i = n++;
    const last = d === 4 && k === count - 1;
    const minute = Math.round(start + ((end - start) * k) / (count - 1)) + (last || k === 0 ? 0 : ((i * 7) % 9) - 4);
    // How long it ran, in minutes: never into the next session; a missed note is long enough for its reason.
    const room = (end - start) / (count - 1) - 7;
    const dur = Math.round(Math.min(room, bad[i] ? 44 : 18 + ((i * 13) % 22)));
    const topic = last ? 'Printer offline' : topics[(i * 5) % topics.length]!;
    return { i, id: `#${48213 - (45 - i) * 7}`, time: hhmm(minute), start: minute, dur, logged: `0:${String(dur).padStart(2, '0')}`, topic, bad: bad[i], last };
  });
  return { name: dayNames[d]!, tiles };
});
