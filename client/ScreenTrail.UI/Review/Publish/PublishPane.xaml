<UserControl x:Class="ScreenTrail.UI.Review.Publish.PublishPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
             xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
             Background="Transparent"
             AutomationProperties.Name="Receipt">
    <!-- Spec v0.6.0 §5 S3, the receipt: after publishing, the session pane becomes this (a state of the
         same pane, never a dialog). What landed where, one row per destination with its state in a word,
         a glyph and a colour and its provider-named link; the session's facts; that editing happens in
         the PSA from here; and on the right, the next session to check, one key away. -->
    <UserControl.InputBindings>
        <!-- Enter opens the next session to check. A focused button takes its own Enter first, so Enter on
             a link opens the link and Enter on Retry retries. -->
        <KeyBinding Key="Return" Command="{Binding OpenNextCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- A figure in the facts row: the number large, what it counts small under it. -->
        <Style x:Key="Receipt.Figure" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.display}" />
            <Setter Property="FontSize" Value="{DynamicResource Size.xl}" />
            <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                <StackPanel>
                    <!-- The heading, straight in the card's 16 padding (review finding A-23; design system issue 3): no
                         plate inside the card and no ribbon rule under it, which were a card in a card and a thick
                         one-sided edge. The state's glyph at 20 in a 32 px disc of its tint, the heading in
                         Text.Title, the subline a Caption 4 under it, and the brand's mid glyph at the trailing
                         edge on its own frame plate, the one ground §2.0 gives it. The words carry the state. -->
                    <Grid x:Name="ReceiptHeader" Margin="16,16,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ReceiptStateDisc"
                                Grid.Column="0"
                                Width="{DynamicResource Layout.control-height}"
                                Height="{DynamicResource Layout.control-height}"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                CornerRadius="{DynamicResource Radius.pill}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.bg.success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReceiptTone}" Value="Partial">
                                            <Setter Property="Background" Value="{DynamicResource Brush.bg.warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ReceiptTone}" Value="NotConfirmed">
                                            <Setter Property="Background" Value="{DynamicResource Brush.bg.warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ReceiptTone}" Value="Failed">
                                            <Setter Property="Background" Value="{DynamicResource Brush.bg.danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <controls:Glyph HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource Icon.lg}" Text="{Binding ReceiptGlyph}">
                                <controls:Glyph.Style>
                                    <Style BasedOn="{StaticResource Icon}" TargetType="controls:Glyph">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.state.published}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReceiptTone}" Value="Partial">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.state.paused}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ReceiptTone}" Value="NotConfirmed">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.state.paused}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ReceiptTone}" Value="Failed">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:Glyph.Style>
                            </controls:Glyph>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Title}"
                                       Text="{Binding ReceiptHeading}"
                                       controls:LiveRegion.Setting="Assertive" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Text.Caption}"
                                       Text="{Binding ReceiptSubline}" />
                        </StackPanel>
                        <!-- The brand's mid glyph (Spec §2.0: 28 to 48 px) on the frame, radius 8 (design system §8),
                             at the trailing edge as a letterhead carries its mark. -->
                        <Border x:Name="ReceiptMarkPlate"
                                Grid.Column="2"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.brand.frame}"
                                CornerRadius="{DynamicResource Radius.card}">
                            <Control x:Name="ReceiptMark"
                                     Width="40"
                                     Height="40"
                                     Focusable="False"
                                     IsTabStop="False"
                                     Template="{StaticResource Brand.Glyph.Frame}" />
                        </Border>
                    </Grid>

                    <!-- A full-width rule 16 under the heading, then the rows in the card's padding. -->
                    <Border x:Name="ReceiptDivider" Margin="0,16,0,0" BorderBrush="{DynamicResource Brush.border.subtle}" BorderThickness="0,1,0,0" />

                    <StackPanel Margin="{DynamicResource Padding.card}">
                        <!-- What happened, in Spec §6's words, when the heading does not already say it all. -->
                        <TextBlock Margin="0,0,0,12"
                                   Style="{StaticResource Text.Body}"
                                   Text="{Binding Summary}"
                                   Visibility="{Binding SummaryVisibility}" />

                        <!-- One shared size scope (review finding A-24), so every row's badge and link start at one x
                             whatever the destination's words or the provider's name. -->
                        <controls:Repeater x:Name="ReceiptRows" ItemsSource="{Binding Results}" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One row per destination, at least 48 high, a rule between rows and none above the
                                         first: the mark, a Segoe Fluent glyph in its state's hue (Icon.Check, Icon.Close,
                                         Icon.Unknown), the destination and what went there, the state in a word, and the
                                         link named for the provider. -->
                                    <Border x:Name="Row"
                                            MinHeight="{DynamicResource Layout.receipt-row-height}"
                                            Padding="0,8"
                                            BorderBrush="{DynamicResource Brush.border.subtle}"
                                            BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Badge" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Link" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <!-- State colours are indicators (Spec §2.1): the glyph takes it, the words stay text.primary. -->
                                            <controls:Glyph Grid.Column="0"
                                                            Width="{DynamicResource Icon.control}"
                                                            Margin="0,0,12,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="{DynamicResource Icon.control}"
                                                            AutomationProperties.Name="{Binding MarkName}">
                                                <controls:Glyph.Style>
                                                    <Style BasedOn="{StaticResource Icon}" TargetType="controls:Glyph">
                                                        <Setter Property="Text" Value="{StaticResource Icon.Unknown}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.state.paused}" />
                                                        <Style.Triggers>
                                                            <!-- By the row's Mark, which names the icon (PublishResultRow.Mark). -->
                                                            <DataTrigger Binding="{Binding Mark}" Value="Icon.Check">
                                                                <Setter Property="Text" Value="{StaticResource Icon.Check}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.state.published}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Mark}" Value="Icon.Close">
                                                                <Setter Property="Text" Value="{StaticResource Icon.Close}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:Glyph.Style>
                                            </controls:Glyph>
                                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,8,0" Style="{StaticResource Text.BodyStrong}" Text="{Binding Label}" />
                                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" />
                                            </WrapPanel>
                                            <!-- The state in a word: the tint and border agree with it, the words carry it. -->
                                            <ContentControl Grid.Column="2"
                                                            Margin="12,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource Badge}"
                                                            theme:Badge.Tone="{Binding BadgeTone}"
                                                            Content="{Binding Badge}" />
                                            <Button Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource Button.Link}"
                                                    Content="{Binding LinkText}"
                                                    AutomationProperties.Name="{Binding LinkName}"
                                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Link}"
                                                    Visibility="{Binding LinkVisibility}" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="3"
                                                       Margin="0,4,0,0"
                                                       Style="{StaticResource Text.Muted}"
                                                       Text="{Binding Error}"
                                                       Visibility="{Binding ErrorVisibility}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </controls:Repeater>

                        <!-- ST-097 AC2: the article's company is not mapped, so ask once, here, and remember the
                             answer. Shown in place of Retry, which would only fail the same way. -->
                        <ContentControl Style="{StaticResource Banner}"
                                theme:Banner.Tone="Warning"
                                theme:Banner.Title="KB article not sent yet"
                                Margin="0,4,0,12"
                                Visibility="{Binding MappingVisibility}"
                                AutomationProperties.Name="Company mapping">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}"
                                           Text="{Binding MappingPrompt}"
                                           controls:LiveRegion.Setting="Polite" />
                                <!-- As wide as the side column, or the card's width where that is less:
                                     beside the inbox rail (v0.6.4) the receipt's main column can be under
                                     300, and a fixed least width cut the box and its focus ring off. -->
                                <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="{DynamicResource Layout.side-column}" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Companies}"
                                          SelectedItem="{Binding SelectedCompany}"
                                          DisplayMemberPath="Name"
                                          AutomationProperties.Name="Company in the knowledge base">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                </Grid>
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource Text.Error}"
                                           Text="{Binding MappingError}"
                                           Visibility="{Binding MappingErrorVisibility}"
                                           controls:LiveRegion.Setting="Assertive" />
                                <Button Margin="0,8,0,0"
                                        Style="{StaticResource Button.Secondary}"
                                        HorizontalAlignment="Left"
                                        Content="Map and publish the article"
                                        Command="{Binding MapAndPublishCommand}"
                                        IsEnabled="{Binding CanMap}" />
                            </StackPanel>
                        </ContentControl>

                        <!-- Something may already be on the ticket. Publish, Ctrl+Enter and Retry wait until the
                             technician ticks the box, which is in the tab order and spent on the next send. -->
                        <ContentControl Style="{StaticResource Banner}"
                                theme:Banner.Tone="Warning"
                                theme:Banner.Glyph="{StaticResource Icon.Unknown}"
                                theme:Banner.Title="Not confirmed"
                                Margin="0,4,0,12"
                                Visibility="{Binding CheckTicketVisibility}"
                                AutomationProperties.Name="Check the ticket first">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}"
                                           Text="{Binding CheckTicketPrompt}"
                                           controls:LiveRegion.Setting="Polite" />
                                <CheckBox Margin="0,8,0,0"
                                          IsChecked="{Binding TicketChecked}"
                                          IsEnabled="{Binding CanCheckTicket}"
                                          AutomationProperties.Name="{Binding CheckTicketLabel}">
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding CheckTicketLabel}" />
                                </CheckBox>
                            </StackPanel>
                        </ContentControl>
                        <Button Margin="0,0,0,12"
                                Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Left"
                                Content="{Binding RetryLabel}"
                                AutomationProperties.Name="{Binding RetryName}"
                                Command="{Binding RetryCommand}"
                                IsEnabled="{Binding CanRetry}"
                                Visibility="{Binding RetryVisibility}"
                                AutomationProperties.HelpText="{Binding CheckTicketPrompt}" />

                        <!-- The session's facts: counts and times only. -->
                        <Border Padding="0,16,0,0" BorderBrush="{DynamicResource Brush.border.subtle}" BorderThickness="0,1,0,0">
                            <controls:Repeater ItemsSource="{Binding ReceiptFacts}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,12,0" AutomationProperties.Name="{Binding Caption}">
                                            <TextBlock Style="{StaticResource Receipt.Figure}" Text="{Binding Value}" />
                                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </controls:Repeater>
                        </Border>

                        <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Secondary}" FontSize="{DynamicResource Size.sm}" Text="{Binding ChangeNote}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Next to check, then the day so far. Open next is the receipt's one filled button. -->
            <StackPanel Grid.Column="2" Width="{DynamicResource Layout.side-column}" VerticalAlignment="Top">
                <Border Style="{StaticResource Card}" Padding="{DynamicResource Padding.card}" AutomationProperties.Name="Next to check">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Label}" Text="Next to check" />
                        <StackPanel Visibility="{Binding NextVisibility}">
                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding NextTitle}" />
                            <TextBlock Margin="0,4,0,12" Style="{StaticResource Text.Muted}" Text="{Binding NextMeta}" />
                            <Button x:Name="OpenNextButton"
                                    Style="{StaticResource Button.Primary}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding OpenNextCommand}"
                                    AutomationProperties.Name="Open next"
                                    AutomationProperties.AcceleratorKey="Enter">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Glyph FontFamily="{DynamicResource Font.icon}" FontSize="{DynamicResource Icon.control}" VerticalAlignment="Center" Text="{StaticResource Icon.Forward}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Open next" />
                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.KeyHint}" Text="Enter" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="Nothing else to check right now." Visibility="{Binding NoNextVisibility}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Style="{StaticResource Card}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Brush.border.strong}"
                        Visibility="{Binding TodayVisibility}"
                        AutomationProperties.Name="Today">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,8" Style="{StaticResource Text.Label}" Text="Today" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Text.Body}" Text="Published" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.BodyStrong}" Text="{Binding TodayPublished}" />
                        <TextBlock Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource Text.Body}" Text="Left to check" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource Text.BodyStrong}" Text="{Binding TodayLeft}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
