<UserControl x:Class="ScreenTrail.UI.Review.Timeline.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
             AutomationProperties.Name="Timeline and transcript">
    <!-- Spec §5 S3: 40 px of scrubber collapsed, 176 px with the transcript open (A-20). The track is drawn in
         code-behind from the markers' fractions, because a Canvas wants pixels and the model has none. -->
    <Border Style="{StaticResource Timeline}" Height="{Binding Height}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Review finding E-24: a disclosure button, so a screen reader hears "collapsed" or "expanded"
                     rather than a "▸" it cannot read. A chevron at 12, right when closed and down when open,
                     8 from the words (design system 8). -->
                <controls:DisclosureButton x:Name="Toggle"
                                           Grid.Column="0"
                                           Style="{StaticResource Button.Ghost}"
                                           VerticalAlignment="Center"
                                           IsExpanded="{Binding Expanded, Mode=OneWay}"
                                           Command="{Binding ToggleCommand}"
                                           AutomationProperties.Name="Timeline and transcript"
                                           AutomationProperties.AcceleratorKey="Alt+T">
                    <StackPanel Orientation="Horizontal">
                        <controls:Glyph VerticalAlignment="Center" FontSize="{DynamicResource Icon.sm}">
                            <controls:Glyph.Style>
                                <Style BasedOn="{StaticResource Icon}" TargetType="controls:Glyph">
                                    <Setter Property="Text" Value="{StaticResource Icon.ChevronRight}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Expanded}" Value="True">
                                            <Setter Property="Text" Value="{StaticResource Icon.ChevronDown}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:Glyph.Style>
                        </controls:Glyph>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Timeline and transcript" />
                    </StackPanel>
                </controls:DisclosureButton>
                <!-- Beside the toggle it belongs to: a key cap, as the envelope's Change carries Ctrl+T. -->
                <Border Grid.Column="1" Margin="4,0,12,0" Style="{StaticResource KeyCap}">
                    <TextBlock Style="{StaticResource Text.KeyHint}" Text="Alt+T" />
                </Border>

                <!-- Dots are clicks, squares are frames, a flag is a marked moment, bands are gaps. -->
                <Canvas Grid.Column="2"
                        x:Name="Track"
                        Height="18"
                        VerticalAlignment="Center"
                        ClipToBounds="True"
                        AutomationProperties.Name="Timeline: clicks, screenshots, things said, pauses" />

                <TextBlock Grid.Column="3"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}"
                           FontSize="{DynamicResource Size.xs}"
                           Text="{Binding Summary}" />
            </Grid>

            <!-- The transcript: monospace, wall-clock stamped, one line per thing said. Selecting a line
                 highlights its frame in the filmstrip; a line with no frame highlights nothing. -->
            <ListBox Grid.Row="1"
                     Margin="0,4,0,8"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding Lines}"
                     SelectedItem="{Binding SelectedLine}"
                     Visibility="{Binding TranscriptVisibility}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Transcript">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource Text.Mono}"
                                   FontSize="{DynamicResource Size.sm}"
                                   TextWrapping="Wrap"
                                   Text="{Binding Display}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
