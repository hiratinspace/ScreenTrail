<UserControl x:Class="ScreenTrail.UI.Settings.Privacy.PrivacyPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
        xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
             AutomationProperties.Name="Privacy">
    <StackPanel MaxWidth="{DynamicResource Layout.content-max-width}" HorizontalAlignment="Stretch">

        <!-- Spec §5 S6 "What leaves this device": the data flow in plain language, matching docs/security/data-flow.md.
             Review finding B-48: the approver's trust story as five steps, each a 16 px glyph in text.secondary,
             12, and a line of Body, then the promise in Body strong; it was one run of numbered text. -->
        <Border Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.TileHeading}" Text="What leaves this PC" />
                <StackPanel x:Name="DataFlow" Margin="0,8,0,0">
                    <Grid MinHeight="{DynamicResource Layout.flow-row-height}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Glyph Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Icon}" Text="{DynamicResource Icon.Camera}" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Captured on this PC." />
                    </Grid>
                    <Grid MinHeight="{DynamicResource Layout.flow-row-height}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Glyph Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Icon}" Text="{DynamicResource Icon.Shield}" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Masked on this PC." />
                    </Grid>
                    <Grid MinHeight="{DynamicResource Layout.flow-row-height}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Glyph Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Icon}" Text="{DynamicResource Icon.Sync}" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="One request drafts the note, or this PC drafts it in local-only mode." />
                    </Grid>
                    <Grid MinHeight="{DynamicResource Layout.flow-row-height}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Glyph Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Icon}" Text="{DynamicResource Icon.Edit}" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="You check it." />
                    </Grid>
                    <Grid MinHeight="{DynamicResource Layout.flow-row-height}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Glyph Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Icon}" Text="{DynamicResource Icon.Send}" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="You publish it." />
                    </Grid>
                </StackPanel>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap" Text="Nothing is published without your check." />
            </StackPanel>
        </Border>

        <!-- Local-only, locked when the admin set it (INV-11): the toggle stays visible, read-only, with the reason. -->
        <Border Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.TileHeading}" Text="Local-only mode" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[LocalOnlyMode]}" />
                </StackPanel>
                <CheckBox Margin="0,8,0,0" Content="Send nothing for drafting; publish only what I ask" IsChecked="{Binding LocalOnly}" IsEnabled="{Binding LocalOnlyEditable}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" Text="{Binding LockedBecause}" ToolTip="{Binding LockedDetail}" AutomationProperties.HelpText="{Binding LockedDetail}" Visibility="{Binding LocalOnlyLockVisibility}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="Local-only keeps the screenshots on this PC. Notes are drafted here from what was said and shown. They are plainer than a usual draft, and Review marks them." />
            </StackPanel>
        </Border>

        <!-- Excluded apps: process names, never captured. The shipped list is the defaults and is not editable here. -->
        <Border Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.TileHeading}" Text="Excluded apps" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[ExcludedApps]}" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="Password managers, banking tabs and credential prompts are excluded already (Recommended). Browser tabs are matched by the page title shown in the browser's title bar, not by the web address. Add any process that must never be captured." />
                <!-- Review finding B-42: list rows, each 36 high under a rule, the name at the left and Remove
                     at the right, where the Ghost button had read as a word after the name. -->
                <controls:Repeater x:Name="ExcludedList" Margin="0,8,0,0" ItemsSource="{Binding ExcludedProcesses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Settings.ListRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.text.primary}" TextTrimming="CharacterEllipsis" Text="{Binding}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.Ghost}" theme:Density.Compact="True" Content="Remove"
                                            Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding StringFormat='Remove {0} from the excluded apps'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>
                <!-- Every field says what it is above it and how to fill it below (review findings B-13, E-26): the
                     box was blank, with its hint only in the help text a screen reader hears. -->
                <TextBlock Margin="0,16,0,4" Style="{StaticResource Text.Label}" Text="App to exclude" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="{DynamicResource Layout.field}"
                             Style="{StaticResource Input.Default}"
                             Text="{Binding NewProcess, UpdateSourceTrigger=PropertyChanged}"
                             theme:Field.Placeholder="keepass"
                             AutomationProperties.Name="App to exclude"
                             AutomationProperties.HelpText="As Task Manager shows it, for example keepass" />
                    <Button Margin="8,0,0,0" Style="{StaticResource Button.Secondary}" Content="Add" Command="{Binding AddProcessCommand}" IsEnabled="{Binding CanAddProcess}" AutomationProperties.Name="Add app" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="As Task Manager shows it, for example keepass" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Text="{Binding NewProcessProblem}" Visibility="{Binding NewProcessProblemVisibility}" controls:LiveRegion.Setting="Polite" />
            </StackPanel>
        </Border>

        <!-- Redaction patterns, with the custom one checked as it is typed and tried against a sample. -->
        <Border Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.TileHeading}" Text="Redaction patterns" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[RedactionPatterns]}" />
                </StackPanel>
                <CheckBox Margin="0,8,0,0" Content="Social security numbers" IsChecked="{Binding Ssn}" />
                <CheckBox Margin="0,4,0,0" Content="Card numbers" IsChecked="{Binding Cards}" />
                <CheckBox Margin="0,4,0,0" Content="API keys, tokens and private keys" IsChecked="{Binding ApiKeys}" />
                <CheckBox Margin="0,4,0,0" Content="Passwords, when said or typed after a cue" IsChecked="{Binding Passwords}" />
                <CheckBox Margin="0,4,0,0" Content="Email addresses" IsChecked="{Binding Emails}" />

                <TextBlock Margin="0,16,0,8" Style="{StaticResource Text.Label}" Text="Custom patterns (regular expressions)" />
                <controls:Repeater x:Name="PatternList" ItemsSource="{Binding CustomPatterns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Settings.ListRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.text.primary}" TextTrimming="CharacterEllipsis" Text="{Binding}" ToolTip="{Binding}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.Ghost}" theme:Density.Compact="True" Content="Remove"
                                            Command="{Binding DataContext.RemovePatternCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding StringFormat='Remove the pattern {0}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>
                <TextBlock Margin="0,8,0,4" Style="{StaticResource Text.Label}" Text="New pattern" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="{DynamicResource Layout.field-wide}"
                             Style="{StaticResource Input.Default}"
                             FontFamily="{DynamicResource Font.mono}"
                             Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}"
                             theme:Field.Placeholder="TKT-\d{6}"
                             AutomationProperties.Name="New pattern" />
                    <Button Margin="8,0,0,0" Style="{StaticResource Button.Secondary}" Content="Add" Command="{Binding AddPatternCommand}" IsEnabled="{Binding CanAddPattern}" AutomationProperties.Name="Add pattern" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Text="{Binding NewPatternProblem}" Visibility="{Binding NewPatternProblemVisibility}" controls:LiveRegion.Setting="Polite" />
                <TextBlock Margin="0,16,0,4" Style="{StaticResource Text.Label}" Text="Try it on some text" />
                <TextBox Style="{StaticResource Input.Default}" Text="{Binding Sample, UpdateSourceTrigger=PropertyChanged}" theme:Field.Placeholder="Paste a line from a ticket" AutomationProperties.Name="Try it on some text" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Mono}" TextWrapping="Wrap" Text="{Binding SampleMasked}" AutomationProperties.Name="What the sample becomes" />
            </StackPanel>
        </Border>

        <!-- Retention, locked when the admin's policy set it. -->
        <Border Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.TileHeading}" Text="Retention" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[Retention]}" />
                </StackPanel>
                <!-- Maximum binds before Value: until it does, the slider's top is WPF's 10, and a value bound first would be clamped and pushed back. -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Slider Width="{DynamicResource Layout.slider-width}" Minimum="1" Maximum="{Binding RetentionMaximum}" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RetentionDays}" IsEnabled="{Binding RetentionEditable}" AutomationProperties.Name="Retention in days" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Numeric}" Text="{Binding RetentionDays}" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="days" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" Text="{Binding LockedBecause}" ToolTip="{Binding LockedDetail}" AutomationProperties.HelpText="{Binding LockedDetail}" Visibility="{Binding RetentionLockVisibility}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding RetentionLabel}" />
            </StackPanel>
        </Border>

        <!-- Telemetry, with the exact field list, read off the wire type. -->
        <Border Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.TileHeading}" Text="Usage telemetry" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[UsageTelemetry]}" />
                </StackPanel>
                <CheckBox Margin="0,8,0,0" Content="Send one usage record per session. It never holds text from a session." IsChecked="{Binding Telemetry}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="Exactly these fields, and never any text from a session:" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Mono}" TextWrapping="Wrap" Text="{Binding TelemetryFieldList}" />
            </StackPanel>
        </Border>

        <!-- Saved by the page's one Save bar (Spec, Settings layout). Why this section cannot be saved as it
             is, or why an export did not land, stays here beside the fields. -->
        <TextBlock Margin="0,0,0,0" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Text="{Binding Problem}" Visibility="{Binding ProblemVisibility}" controls:LiveRegion.Setting="Polite" />

        <!-- Your data, the danger zone at the end of Privacy: export the audit log; delete everything, typed
             (INV-12), with the capture guard (#280). Both act at once and are never on the Save bar. Review
             finding B-41: outlined like its neighbours, not in red; the danger is the Delete button's. -->
        <Border x:Name="YourData" Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.TileHeading}" Text="Your data" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="These act straight away. They are not part of Save." />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource Button.Secondary}" Content="Export audit log" Command="{Binding ExportAuditCommand}" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource Button.Danger}"
                            Content="Delete everything on this PC…"
                            Command="{Binding EraseEverythingCommand}"
                            AutomationProperties.Name="Delete everything on this PC"
                            AutomationProperties.HelpText="Deletes every session, draft, screenshot and transcript on this PC, with your settings and this PC's sign-in. Notes already published stay on their tickets. You will be asked to type DELETE EVERYTHING." />
                </StackPanel>
                <!-- Why it did not happen (a session is being captured, the service is not answering, or it
                     refused): beside the button, never a dialog, and read out as it changes (Spec §4). -->
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource Text.Error}"
                           TextWrapping="Wrap"
                           Text="{Binding EraseProblem}"
                           Visibility="{Binding EraseProblemVisibility}"
                           controls:LiveRegion.Setting="Assertive" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="Delete removes every session, draft, screenshot and transcript on this PC, with your settings and this PC's sign-in. Notes already published stay on their tickets. You will type DELETE EVERYTHING to confirm. It cannot be undone." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
