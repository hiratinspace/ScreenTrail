<UserControl x:Class="ScreenTrail.UI.Settings.Capture.CapturePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
        xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
             AutomationProperties.Name="Capture">
    <StackPanel MaxWidth="{DynamicResource Layout.content-max-width}" HorizontalAlignment="Stretch">

        <!-- Remote tools: a toggle per tool the registry knows. -->
        <Border Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.TileHeading}" Text="Remote tools" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[RemoteTools]}" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="A session starts when one of these takes focus. Switch one off and its windows are not captured." />
                <controls:Repeater Margin="0,8,0,0" ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,0,0,4" Content="{Binding DisplayName}" IsChecked="{Binding Enabled}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>
            </StackPanel>
        </Border>

        <!-- Capture scope, with the inline warning and a confirmation before "All windows" saves (INV-5). -->
        <Border Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.TileHeading}" Text="Capture scope" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[CaptureScope]}" />
                </StackPanel>
                <RadioButton Margin="0,8,0,0" GroupName="Scope" Content="Remote-tool windows and admin tools (Recommended)" IsChecked="{Binding RemoteToolsOnly}" IsEnabled="{Binding ScopeEditable}" />
                <RadioButton Margin="0,4,0,0" GroupName="Scope" Content="All windows during a session" IsChecked="{Binding AllWindows}" IsEnabled="{Binding ScopeEditable}" />
                <ContentControl Style="{StaticResource Settings.Locked}" Content="{Binding ScopeLockedNote, Mode=OneTime}" Visibility="{Binding ScopeLockVisibility}" />
                <ContentControl Style="{StaticResource Banner}" theme:Banner.Tone="Warning" Margin="0,8,0,0" Visibility="{Binding ScopeWarningVisibility}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding ScopeWarning}" controls:LiveRegion.Setting="Assertive" />
                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}" theme:Density.Compact="True" Content="I understand, capture all windows" Command="{Binding ConfirmAllWindowsCommand}" />
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Border>

        <!-- Auto-start and the grace period. -->
        <Border Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.TileHeading}" Text="Starting and stopping" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[StartingAndStopping]}" />
                </StackPanel>
                <CheckBox Margin="0,8,0,0" Content="Start a session by itself when a remote tool takes focus" IsChecked="{Binding AutoStart}" />
                <TextBlock Margin="0,16,0,4" Style="{StaticResource Text.Label}" Text="Stop when no remote tool has been in front for" />
                <StackPanel Orientation="Horizontal">
                    <Slider Width="{DynamicResource Layout.slider-width}" Minimum="30" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding GraceSeconds}" AutomationProperties.Name="Seconds with no remote tool in front before stopping" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding GraceSeconds}" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="seconds" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Hotkeys, checked as typed; a clash names an alternative inline (ST-029). -->
        <Border Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.TileHeading}" Text="Hotkeys" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[Hotkeys]}" />
                </StackPanel>
                <controls:Repeater Margin="0,8,0,0" ItemsSource="{Binding Hotkeys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Review finding B-12: a clash is said on a second row under the field, across the
                                 field's column and the rest, and the field shows its error edge; it was a red
                                 sentence beside a field that looked fine. -->
                            <Grid x:Name="HotkeyRow" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Width="{DynamicResource Layout.field-narrow}" VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding Label}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Width="{DynamicResource Layout.field-narrow}" Style="{StaticResource Input.Default}" FontFamily="{DynamicResource Font.mono}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" theme:Field.HasError="{Binding Problem, Converter={StaticResource HasText}}" AutomationProperties.Name="{Binding Label}" />
                                <ContentControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Field.ErrorLine}" Content="{Binding Problem}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>
            </StackPanel>
        </Border>

        <!-- Screenshots. Review finding B-39: the microphone and the speech model are a tile of their own,
             not two more heading levels inside this one (one group per tile, spec v0.7.0). -->
        <Border Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.TileHeading}" Text="Screenshots" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[Screenshots]}" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" Text="How readily a screenshot is taken when the screen changes between clicks." />

                <!-- Each choice by its name, "High: more screenshots" (v0.6.8); the stored value, "high", is not shown. -->
                <ComboBox Margin="0,8,0,0" Width="{DynamicResource Layout.field}" HorizontalAlignment="Left" ItemsSource="{Binding Sensitivities}" SelectedItem="{Binding SelectedSensitivity}" DisplayMemberPath="Label" AutomationProperties.Name="Scene-change sensitivity">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- The microphone: Device, Level and Speech model, labelled fields 16 apart. ST-080 AC3: the level
             is read only while this tile is on screen with the window in front (the code-behind says when);
             nothing is recorded. -->
        <Border x:Name="MicrophoneTile" Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel x:Name="MicrophoneCard">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.TileHeading}" Text="Microphone" />
                        <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[Microphone]}" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,4" Style="{StaticResource Text.Label}" Text="Device" />
                    <ComboBox Width="{DynamicResource Layout.field-wide}" HorizontalAlignment="Left" ItemsSource="{Binding MicrophoneOptions}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Label" AutomationProperties.Name="Microphone">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <!-- A state, not a hint (v0.7.1): the in-card warning banner the scope warning uses. -->
                    <ContentControl Margin="0,8,0,0" Style="{StaticResource Banner}" theme:Banner.Tone="Warning" Visibility="{Binding MicrophoneNoteVisibility}">
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding MicrophoneNote}" controls:LiveRegion.Setting="Polite" />
                    </ContentControl>
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Level" />
                        <ProgressBar Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Meter.Level}" Value="{Binding MicrophoneLevel, Mode=OneWay}" theme:Meter.Clipping="{Binding MicrophoneClipping, Mode=OneWay}" AutomationProperties.Name="Microphone level" AutomationProperties.HelpText="{Binding MicrophoneLevelStatus}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding MicrophoneLevelStatus}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding MicrophoneApplies, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Margin="0,16,0,4" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Speech model" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[SpeechModel]}" />
                </StackPanel>

                <!-- Never empty (v0.6.8): the default, "Automatic (Recommended)", is a line of its own and is
                     what a new installation shows. Each line by its plain name, as the sensitivity's are; what
                     the chosen one is, and which model Automatic runs, is the helper line under it (v0.7.1). -->
                <ComboBox Width="{DynamicResource Layout.field-wide}" HorizontalAlignment="Left" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Label" AutomationProperties.Name="Speech model" AutomationProperties.HelpText="{Binding ModelHint}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Hint}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding ModelHint}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding AppliesAtNextStart}" />
            </StackPanel>
        </Border>

        <!-- Every tile opens with its heading (B-39): this one was a lone check box. -->
        <Border x:Name="StartWithWindowsTile" Style="{StaticResource Settings.Tile}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.TileHeading}" Text="Start with Windows" />
                    <ContentControl Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Badge.Changed}" Content="Changed" Visibility="{Binding Changed[StartAtSignIn]}" />
                </StackPanel>
                <CheckBox Margin="0,8,0,0" Content="Start ScreenTrail when I sign in to Windows" IsChecked="{Binding StartUiAtLogin}" />
            </StackPanel>
        </Border>

        <!-- Saved by the page's one Save bar (Spec, Settings layout). Why this section cannot be saved as it
             is stays here, after its tiles, as well as on the bar when a save is tried: it may be the service
             refusing the whole section, so it belongs to no one tile. A field's own problem is also said
             under that field (B-12). The shared error line, glyph and words. -->
        <ContentControl Margin="0,4,0,12" Style="{StaticResource Field.ErrorLine}" Content="{Binding Problem}" />
    </StackPanel>
</UserControl>
