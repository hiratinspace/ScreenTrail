<UserControl x:Class="ScreenTrail.UI.Settings.Integrations.IntegrationsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
        xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
             xmlns:local="clr-namespace:ScreenTrail.UI.Settings.Integrations"
             AutomationProperties.Name="Integrations">
    <UserControl.Resources>
        <!-- One card per provider (Spec §5 S7, v0.6.15), read only: integration credentials can only be
             changed by the tenant owner, in the web admin. The card says what is connected and who
             changes it; Test connection checks the credential the backend holds. -->
        <DataTemplate x:Key="IntegrationCardTemplate" DataType="{x:Type local:IntegrationCardViewModel}">
            <Border Style="{StaticResource Settings.Tile}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.TileHeading}" Text="{Binding Title}" />
                        <ContentControl Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Badge}"
                                theme:Badge.Tone="Success"
                                        Content="Connected"
                                        Visibility="{Binding ConnectedBadgeVisibility}" />
                        <!-- In Connected's place when the last check failed (v0.7.1): the warning tint, so
                             the badge never says Connected over a credential that did not work. -->
                        <ContentControl Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Badge}"
                                theme:Badge.Tone="Warning"
                                        Content="Check failed"
                                        Visibility="{Binding CheckFailedBadgeVisibility}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" Text="{Binding Status}" Visibility="{Binding StatusVisibility}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding OwnerLine}" />

                    <!-- Connected: the site in full and when the credential was connected. No part of the
                         credential is shown (security review E-14, DEC-11). -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding SummaryVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Site" />
                            <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Label}" Text="Credential" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding SiteUrl}" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Body}" Text="{Binding ConnectedLine}" />
                        </StackPanel>
                    </Grid>

                    <!-- Test connection, and the last answer in words either way (Spec §4). -->
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="Test connection"
                                Command="{Binding CheckCommand}"
                                AutomationProperties.Name="{Binding Title, StringFormat='Test connection to {0}'}" />
                    </StackPanel>
                    <!-- Review finding B-43: a 16 px check in state.published or a warning in state.danger, 8,
                         then the words in Body, wrapping at the tile's width (not a 520 literal). -->
                    <Grid x:Name="CheckLine" Margin="0,8,0,0" Visibility="{Binding CheckVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Glyph Grid.Column="0" VerticalAlignment="Top">
                            <controls:Glyph.Style>
                                <Style BasedOn="{StaticResource Icon}" TargetType="controls:Glyph">
                                    <Setter Property="Text" Value="{DynamicResource Icon.Warning}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CheckPassed}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Icon.Check}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.state.published}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:Glyph.Style>
                        </controls:Glyph>
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap"
                                   Text="{Binding CheckResult}"
                                   controls:LiveRegion.Setting="Polite" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- No scroller of its own: the Settings page scrolls, and a second scroller inside it held the wheel. -->
    <StackPanel MaxWidth="{DynamicResource Layout.content-max-width}" HorizontalAlignment="Stretch">
        <ContentControl Style="{StaticResource Banner}" theme:Banner.Tone="Warning" Margin="0,0,0,12" Visibility="{Binding NoticeVisibility}">
            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding Notice}" controls:LiveRegion.Setting="Polite" />
        </ContentControl>

        <!-- What the backend lists beyond the two cards, by name: its Development demo (ST-090), named so
             nobody takes it for ConnectWise or Hudu, or a provider this version does not know. -->
        <Border Style="{StaticResource Settings.Tile}" Visibility="{Binding OthersVisibility}">
            <controls:Repeater ItemsSource="{Binding Others}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.TileHeading}" Text="{Binding Title}" />
                                <ContentControl Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Badge}"
                                theme:Badge.Tone="Success"
                                                Content="Connected"
                                                Visibility="{Binding BadgeVisibility}" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" Text="{Binding Status}" Visibility="{Binding StatusVisibility}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding SiteUrl}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Text="{Binding LastError}" Visibility="{Binding ErrorVisibility}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </controls:Repeater>
        </Border>

        <!-- Not Tab stops themselves (a ContentControl is one by default): Tab goes to the card's buttons (ST-084). -->
        <ContentControl Content="{Binding ConnectWise}" ContentTemplate="{StaticResource IntegrationCardTemplate}" Focusable="False" />
        <ContentControl Content="{Binding Hudu}" ContentTemplate="{StaticResource IntegrationCardTemplate}" Focusable="False" />

        <!-- The company mapping table: the PSA's name for a company beside the Hudu company it is
             filed under, with how the backend decided (ST-097). Only with Hudu connected. -->
        <!-- Review finding E-15: the two columns are named, and the sentence says who files the article.
             The header and every row share their Auto columns' widths (Grid.IsSharedSizeScope), so the two
             name columns and the badges line up down the list (B-42). -->
        <Border Style="{StaticResource Settings.Tile}" Visibility="{Binding MappingsVisibility}">
            <StackPanel x:Name="MappingTable" Grid.IsSharedSizeScope="True">
                <TextBlock Style="{StaticResource Text.TileHeading}" Text="Company mapping" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="ScreenTrail files each KB article under the ticket's company in Hudu. Same names match by themselves. For any other, you are asked once, the first time, and the answer is kept here." />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="No companies mapped yet. You are asked the first time you publish an article for a company." Visibility="{Binding NoMappingsVisibility}" />
                <Grid x:Name="MappingHeader" Margin="0,12,0,4" Visibility="{Binding HasMappingsVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Badge" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Action" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Label}" Text="In ConnectWise" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Text.Label}" Text="In Hudu" />
                </Grid>
                <controls:Repeater ItemsSource="{Binding Mappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="{DynamicResource Layout.row-height}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Badge" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Action" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" Text="{Binding PsaCompany}" ToolTip="{Binding PsaCompany}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" Text="{Binding DocCompanyName}" ToolTip="{Binding DocCompanyName}" VerticalAlignment="Center" />
                                <ContentControl Grid.Column="2" Style="{StaticResource Badge}" Content="{Binding ConfidenceLabel}" VerticalAlignment="Center" />
                                <Button Grid.Column="3"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource Button.Ghost}"
                                        theme:Density.Compact="True"
                                        Content="Forget"
                                        AutomationProperties.Name="{Binding PsaCompany, StringFormat='Forget the mapping for {0}'}"
                                        Command="{Binding DataContext.UnmapCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>

                <Border Margin="0,12,0,12" Height="1" Background="{DynamicResource Brush.border.subtle}" />
                <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Map a company by hand" />
                <!-- One label per field (review findings B-13, E-26): one label over a box and a combo said
                     nothing about either. -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" Style="{StaticResource Field.Label}" Content="Com_pany in ConnectWise" Target="{Binding ElementName=NewPsaCompanyBox}" />
                    <Label Grid.Row="0" Grid.Column="1" Margin="8,0,0,4" Style="{StaticResource Field.Label}" Content="Company in _Hudu" Target="{Binding ElementName=NewDocCompanyBox}" />
                    <TextBox x:Name="NewPsaCompanyBox" Grid.Row="1"
                             Grid.Column="0"
                             Style="{StaticResource Input.Default}"
                             Text="{Binding NewPsaCompany, UpdateSourceTrigger=PropertyChanged}"
                             theme:Field.Placeholder="Exactly as ConnectWise names it"
                             AutomationProperties.Name="Company in ConnectWise"
                             AutomationProperties.HelpText="Exactly as ConnectWise names it" />
                    <ComboBox x:Name="NewDocCompanyBox" Grid.Row="1"
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding Companies}"
                              SelectedItem="{Binding NewDocCompany}"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="Company in Hudu">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Style="{StaticResource Button.Secondary}"
                            Content="Map"
                            Command="{Binding AddMappingCommand}"
                            IsEnabled="{Binding CanAddMapping}" />
                </Grid>
                <ContentControl Style="{StaticResource Field.ErrorLine}" Content="{Binding MappingProblem}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
