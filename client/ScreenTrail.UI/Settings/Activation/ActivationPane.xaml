<UserControl x:Class="ScreenTrail.UI.Settings.Activation.ActivationPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
             xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
             AutomationProperties.Name="This device">
    <!-- Spec §5 S8 step 2, here until the onboarding wizard exists (ST-083): the code from the invite
         goes in, the tenant's name comes back. The refresh token stays with the service. -->
    <Border Style="{StaticResource Settings.Tile}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.TileHeading}" Text="This device" />
                <ContentControl Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Badge}"
                                theme:Badge.Tone="Success"
                                Content="Activated"
                                Visibility="{Binding ActivatedVisibility}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="{Binding Standing}"
                       controls:LiveRegion.Setting="Polite" />

            <StackPanel Margin="0,16,0,0" Visibility="{Binding FormVisibility}">
                <Label Margin="0,0,0,4" Style="{StaticResource Field.Label}" Content="_Invite code" Target="{Binding ElementName=InviteCode}" />
                <StackPanel Orientation="Horizontal">
                    <!-- Twenty characters in four groups of five (ADR-0009, "Guessing invite codes"): wide
                         enough for all of them in the mono face, typed in capitals as the invite shows them. -->
                    <TextBox x:Name="InviteCode" Width="{DynamicResource Layout.field-wide}"
                             MaxLength="64"
                             CharacterCasing="Upper"
                             Style="{StaticResource Input.Mono}"
                             Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                             theme:Field.HasError="{Binding Problem, Converter={StaticResource HasText}}"
                             AutomationProperties.Name="Invite code"
                             AutomationProperties.HelpText="Twenty letters and digits in four groups, like KX7PM-4R2WQ-9HTCE-B3NVA" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource Button.Primary}"
                            Content="Activate"
                            Command="{Binding ActivateCommand}"
                            IsEnabled="{Binding CanActivate}" />
                </StackPanel>
                <!-- Review finding B-12: 4 under the field, which shows its error edge. -->
                <ContentControl Style="{StaticResource Field.ErrorLine}" Content="{Binding Problem}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
