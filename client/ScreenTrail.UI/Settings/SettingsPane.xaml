<UserControl x:Class="ScreenTrail.UI.Settings.SettingsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
             xmlns:activation="clr-namespace:ScreenTrail.UI.Settings.Activation"
             xmlns:appearance="clr-namespace:ScreenTrail.UI.Settings.Appearance"
             xmlns:capture="clr-namespace:ScreenTrail.UI.Settings.Capture"
             xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
             xmlns:integrations="clr-namespace:ScreenTrail.UI.Settings.Integrations"
             xmlns:privacy="clr-namespace:ScreenTrail.UI.Settings.Privacy"
             xmlns:update="clr-namespace:ScreenTrail.UI.Update"
             AutomationProperties.Name="Settings">
    <UserControl.Resources>
        <!-- A group of tiles: more space above than below, so the heading belongs to what follows. Review
             finding B-45: 32 above (layout.section-gap) and 12 below; the first section's heading is level
             with the nav's first item instead. -->
        <Style x:Key="Settings.Group" BasedOn="{StaticResource Text.SectionHeading}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,32,0,12" />
        </Style>
    </UserControl.Resources>
    <!-- Ctrl+S saves every changed section (Spec, Settings layout). Esc undoes only from the bar itself
         (the code-behind), because Undo throws away what was typed. -->
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>

    <!-- Spec v0.6.0, Settings layout (owner decision): a nav of the sections beside one scrolling page, and
         one Save bar for the whole page, pinned under it. The bar is its own row, so it never lies over the
         page: the page's view ends above it, and a control that takes focus is scrolled into that view. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- The nav's width (layout.settings-nav-width) is on the nav: a column cannot take a number resource. -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.ScreenTitle}" Text="Settings" />
        <!-- What the last Save did, once it wrote everything: a word, a check and the published colour. -->
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding SavedVisibility}">
            <controls:Glyph Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.state.published}" Text="{StaticResource Icon.Check}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}" Text="{Binding SavedNote}" controls:LiveRegion.Setting="Polite" />
        </StackPanel>

        <!-- The nav: the arrows move through it and bring each section into view; Tab leaves it for the page. -->
        <ListBox x:Name="Nav"
                 Grid.Row="1"
                 Grid.Column="0"
                 Width="{DynamicResource Layout.settings-nav-width}"
                 Margin="0,16,0,0"
                 VerticalAlignment="Top"
                 Style="{StaticResource Settings.Nav}"
                 ItemContainerStyle="{StaticResource Settings.NavItem}"
                 ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection}"
                 SelectionChanged="OnNavSelectionChanged"
                 AutomationProperties.Name="Settings sections">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Settings.NavLabel}" Text="{Binding Label}" />
                        <!-- How many changes the section holds: the number in a badge, read in the item's name. -->
                        <ContentControl Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Badge}"
                                        Content="{Binding PendingText}"
                                        Visibility="{Binding PendingVisibility}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer x:Name="Scroller"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="24,0,0,0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,12,0"
                      ScrollChanged="OnScrollChanged">
            <!-- Each section is a group tagged with its nav key: the nav scrolls to it, and scrolling selects it. -->
            <!-- The readable width, on the left, and narrower when the pane is: beside the inbox rail at the
                 1024 minimum (v0.6.4) the page has under 760, and a fixed width cut the cards' buttons off. -->
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{DynamicResource Layout.content-max-width}" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Page" Grid.Column="0">
                <StackPanel Tag="Activation">
                    <TextBlock Style="{StaticResource Settings.Group}" Margin="0,16,0,12" Text="Activation" />
                    <activation:ActivationPane DataContext="{Binding Activation}" />
                </StackPanel>

                <StackPanel Tag="Capture">
                    <TextBlock Style="{StaticResource Settings.Group}" Text="Capture" />
                    <capture:CapturePane DataContext="{Binding Capture}" />
                </StackPanel>

                <StackPanel Tag="Privacy">
                    <!-- The nav's word (review finding E-17); redaction is inside, as Redaction patterns. -->
                    <TextBlock Style="{StaticResource Settings.Group}" Text="Privacy" />
                    <privacy:PrivacyPane DataContext="{Binding Privacy}" />
                </StackPanel>

                <StackPanel Tag="Integrations">
                    <TextBlock Style="{StaticResource Settings.Group}" Text="Integrations" />
                    <integrations:IntegrationsPane DataContext="{Binding Integrations}" />
                </StackPanel>

                <StackPanel Tag="Appearance">
                    <TextBlock Style="{StaticResource Settings.Group}" Text="Appearance" />
                    <appearance:AppearancePane DataContext="{Binding Appearance}" />
                </StackPanel>

                <!-- ST-113: the last group, so the bottom margin the page ends on is here. -->
                <StackPanel Tag="Updates" Margin="0,0,0,24">
                    <TextBlock Style="{StaticResource Settings.Group}" Text="Updates" />
                    <update:UpdatesPane DataContext="{Binding Updates}" />
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- The one Save bar (Spec §3, Save bar: hidden, pending, saving, failed). Shown only with a change
             pending; pinned; never scrolls. Each state is a word, a mark and a colour: the iris dot while
             pending or saving, the danger cross when a section failed, with the section named in words. -->
        <Border x:Name="Bar"
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource SaveBar}"
                Visibility="{Binding BarVisibility}"
                PreviewKeyDown="OnBarKeyDown"
                IsVisibleChanged="OnBarVisibilityChanged">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.accent.primary}"
                                 Visibility="{Binding PendingMarkVisibility}" />
                        <controls:Glyph Style="{StaticResource Icon}"
                                        Foreground="{DynamicResource Brush.state.danger}"
                                        Text="{StaticResource Icon.Close}"
                                        Visibility="{Binding FailedMarkVisibility}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="NoWrap"
                                   Text="{Binding Summary}"
                                   controls:LiveRegion.Setting="Polite" />
                        <Button Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Button.Link}"
                                Content="{Binding LinkSection}"
                                Command="{Binding GoToCommand}"
                                CommandParameter="{Binding LinkSection}"
                                Visibility="{Binding LinkVisibility}"
                                AutomationProperties.Name="{Binding LinkName}" />
                    </StackPanel>
                    <!-- Which section did not save and why, in the <What happened>. <What to do>. pattern. -->
                    <!-- 24 in: under the summary's words, past the 16 px mark and its 8 gap. -->
                    <TextBlock Margin="24,4,0,0"
                               Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap"
                               Text="{Binding FailureMessage}"
                               controls:LiveRegion.Setting="Assertive" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="Undo changes"
                            Command="{Binding UndoCommand}"
                            AutomationProperties.HelpText="Puts every section back to what was last saved. Esc does the same while the bar has focus." />
                    <!-- The bar's one filled button, the key beside its word as Publish carries Ctrl+Enter, and out of
                         its name (review finding E-22: Narrator read "Save Ctrl+S"). -->
                    <Button Margin="8,0,0,0"
                            MinWidth="96"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.Name="Save"
                            AutomationProperties.AcceleratorKey="Ctrl+S"
                            AutomationProperties.HelpText="{Binding BarName}"
                            theme:Busy.Active="{Binding IsSaving}">
                        <!-- While a save is on its way: the ring and "Saving" in the Primary fill, at the
                             button's rest width, so the bar does not jump (review finding B-46). -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding RestVisibility}">
                                <TextBlock VerticalAlignment="Center" Text="Save" />
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.KeyHint}" Text="Ctrl+S" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Visibility="{Binding SavingVisibility}">
                                <Control VerticalAlignment="Center" Style="{StaticResource ProgressRing}" Foreground="{DynamicResource Brush.text.on-accent}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Saving" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
