<Window x:Class="ScreenTrail.UI.Hud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hud="clr-namespace:ScreenTrail.UI.Hud"
        xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
        Title="ScreenTrail"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False">
    <!-- The app's styles are looked up dynamically, not statically. A static lookup throws while the
         window is built when the app's resources are not there, which is the case on the bare UI thread
         the shell's quit and re-dock tests run on; a dynamic one resolves to the same style in the app. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A state's colour on the frame (Spec §2.1, shell.*). DataTriggers with DynamicResource, not a
             converter: a converter resolves the brush once, at bind time, so it cannot follow a theme swap,
             and the first version silently produced no Foreground at all for three of the four tones. The
             render asserts each variant's token colour is actually on the pill, which is what caught it. -->
        <Style x:Key="Hud.ToneGlyph" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.icon}" />
            <Setter Property="FontSize" Value="{DynamicResource Icon.control}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
            <Style.Triggers>
                <!-- The state's icon by concept (HudGlyphs, review finding C-H3); hidden for the drawn marks. -->
                <DataTrigger Binding="{Binding StateGlyph}" Value="Icon.Pause">
                    <Setter Property="Text" Value="{DynamicResource Icon.Pause}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateGlyph}" Value="Icon.Lock">
                    <Setter Property="Text" Value="{DynamicResource Icon.Lock}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateGlyph}" Value="Icon.Hide">
                    <Setter Property="Text" Value="{DynamicResource Icon.Hide}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateGlyph}" Value="Icon.Unknown">
                    <Setter Property="Text" Value="{DynamicResource Icon.Unknown}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Recording">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.shell.recording}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Paused">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.shell.paused}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Scope">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.shell.scope}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Words on the frame. -->
        <Style x:Key="Hud.Text" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
            <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="Hud.Meta" BasedOn="{StaticResource Hud.Text}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        </Style>
        <Style x:Key="Hud.Muted" BasedOn="{StaticResource Hud.Meta}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
        </Style>

        <!-- An icon-font glyph on the frame, hidden from a screen reader (controls:Glyph). Hud.Glyph takes its
             colour from what holds it: inside a pill button, the button's (shell.muted at rest, shell.text on
             hover, review finding C-H7), so the state word stays the strongest thing on the pill. -->
        <Style x:Key="Hud.Glyph" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.icon}" />
            <Setter Property="FontSize" Value="{DynamicResource Icon.control}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="Hud.Icon" BasedOn="{StaticResource Hud.Glyph}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        </Style>

        <!-- A segment after the state, set off by a short shell.line rule (the masked count, No mic, Offline). -->
        <Style x:Key="Hud.Segment" TargetType="Border">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="Height" Value="{DynamicResource Icon.lg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.shell.line}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
    </Window.Resources>

    <!-- The pill on top and, clicked open, the session card under it. Both left-aligned in one column, so
         opening the card never moves the pill under the pointer, and the card is never narrower than it. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- v0.6.0 (Spec §5 S2): part of the frame. shell.bg, fully rounded, Layout.hud-height (40) tall. No
             ribbon cap (review finding C-H5): the pill's curve cut it into a wedge that read as a rendering
             glitch, and Iris on a status control breaks the brand's one job. The edge is 1 px border.strong
             (C-H6): shell.muted was the loudest line on the pill in dark; high contrast draws 2 px WindowFrame.
             2 above and below, not design system 10.10's 4: 40 less a 1 px edge and 4 + 4 leaves 30, under the
             32 px buttons. The float shadow waits for a Windows check (its margin must be click-through on a
             layered window), so it is not drawn yet. -->
        <Border x:Name="Pill"
                Grid.Row="0"
                HorizontalAlignment="Left"
                Height="{DynamicResource Layout.hud-height}"
                MinWidth="{DynamicResource Layout.hud-min-width}"
                CornerRadius="{DynamicResource Radius.pill}"
                Background="{DynamicResource Brush.shell.bg}"
                BorderBrush="{DynamicResource Brush.border.strong}"
                BorderThickness="{DynamicResource Thickness.float-edge}"
                Padding="12,2,4,2"
                RenderOptions.ClearTypeHint="Enabled"
                MouseLeftButtonDown="OnPillMouseDown"
                MouseRightButtonUp="OnPillRightClick">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- The state segment. Glyph and words both, so it reads with no colour at all (Spec §7),
                         which matters more here than anywhere: this is the indicator INV-4 is about. -->
                    <!-- In a 16 px box (design system 10.10): recording an 8 px dot and not recording an 8 px
                         ring, drawn as vectors; finishing and drafting the progress ring; otherwise the
                         state's Fluent icon (review finding C-H3). -->
                    <Grid Width="{DynamicResource Icon.control}"
                          Height="{DynamicResource Icon.control}"
                          VerticalAlignment="Center"
                          ToolTip="{Binding StateTooltip}">
                        <Ellipse Width="{DynamicResource Layout.state-dot}"
                                 Height="{DynamicResource Layout.state-dot}"
                                 Fill="{DynamicResource Brush.shell.recording}"
                                 Visibility="{Binding ShowDot, Converter={StaticResource Visible}}" />
                        <Ellipse Width="{DynamicResource Layout.state-dot}"
                                 Height="{DynamicResource Layout.state-dot}"
                                 Stroke="{DynamicResource Brush.shell.muted}"
                                 StrokeThickness="1"
                                 Visibility="{Binding ShowRing, Converter={StaticResource Visible}}" />
                        <Control Style="{DynamicResource ProgressRing}"
                                 Foreground="{DynamicResource Brush.shell.muted}"
                                 Visibility="{Binding ShowBusy, Converter={StaticResource Visible}}" />
                        <controls:Glyph x:Name="StateGlyphText" Style="{StaticResource Hud.ToneGlyph}" />
                    </Grid>

                    <!-- One instrument in one order in every state (review finding C-H4, design system 10.10):
                         the state word in Body strong, then the session's clock in Body, frozen while paused.
                         The word changes; the clock keeps its place, so the pill does not jump between a
                         clock and a sentence. -->
                    <!-- A width limit and an ellipsis, the whole words in the tooltip (review finding C-H2): a
                         long app name made the pill a banner over the customer's screen. 200 is what a 420 px
                         pill (design system 10.10) leaves the word beside the mark, the clock and three
                         buttons; the mark, the clock and the buttons never trim. -->
                    <TextBlock Margin="8,0,0,0"
                               MaxWidth="{DynamicResource Layout.hud-word-max}"
                               Style="{StaticResource Hud.Text}"
                               FontWeight="{DynamicResource Weight.semibold}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding StateWord}"
                               ToolTip="{Binding StateWordTooltip}"
                               AutomationProperties.Name="{Binding SpokenState}"
                               controls:LiveRegion.Setting="Assertive"
                               controls:LiveRegion.Key="{Binding Announcement}" />

                    <!-- Drawn without a peer of its own: the clock is already in the state's spoken name. -->
                    <controls:Glyph x:Name="Clock"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource Hud.Text}"
                                    Typography.NumeralAlignment="Tabular"
                                    Text="{Binding Timer}"
                                    Visibility="{Binding ShowTimer, Converter={StaticResource Visible}}" />

                    <!-- The masking segment: screenshots still being masked. -->
                    <Border Style="{StaticResource Hud.Segment}"
                            ToolTip="{Binding RedactionSpoken}"
                            Visibility="{Binding ShowRedactions, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <!-- The shield and "Masking 3" (review finding C-H11, design system amendment 20): the word
                                 says the count is masking still to do, where a shield beside a bare number read as
                                 that many done. -->
                            <controls:Glyph Style="{StaticResource Hud.Icon}" Foreground="{DynamicResource Brush.shell.muted}" Text="{DynamicResource Icon.Shield}" />
                            <TextBlock Margin="4,0,0,0"
                                       Style="{StaticResource Hud.Meta}"
                                       Typography.NumeralAlignment="Tabular"
                                       Text="{Binding RedactionText}"
                                       AutomationProperties.Name="{Binding RedactionSpoken}" />
                        </StackPanel>
                    </Border>

                    <!-- No mic and Offline: the icon carries the hue (shell.offline), the word stays in
                         shell.text, so neither is colour alone. -->
                    <Border Style="{StaticResource Hud.Segment}"
                            ToolTip="{Binding MicTooltip}"
                            Visibility="{Binding ShowMic, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Glyph Style="{StaticResource Hud.Icon}" Foreground="{DynamicResource Brush.shell.offline}" Text="{DynamicResource Icon.Mic}" />
                            <TextBlock Margin="4,0,0,0"
                                       Style="{StaticResource Hud.Meta}"
                                       Text="{Binding MicText}"
                                       AutomationProperties.Name="{Binding MicTooltip, TargetNullValue=''}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Hud.Segment}"
                            ToolTip="{Binding CloudTooltip}"
                            Visibility="{Binding ShowCloud, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Glyph Style="{StaticResource Hud.Icon}" Foreground="{DynamicResource Brush.shell.offline}" Text="{DynamicResource Icon.Cloud}" />
                            <TextBlock Margin="4,0,0,0"
                                       Style="{StaticResource Hud.Meta}"
                                       Text="{Binding CloudText}"
                                       AutomationProperties.Name="{Binding CloudTooltip, TargetNullValue=''}" />
                        </StackPanel>
                    </Border>

                    <!-- Mark, Pause or Resume, Stop: one click each, 32 px, each offered only where the
                         service would accept it (HudControls). The tooltip names the hotkey. -->
                    <Button Margin="8,0,0,0"
                            Style="{DynamicResource Hud.IconButton}"
                            Command="{Binding MarkCommand}"
                            ToolTip="{Binding MarkButton.Tooltip}"
                            AutomationProperties.Name="{Binding MarkButton.Name}"
                            AutomationProperties.AcceleratorKey="{Binding MarkButton.Hotkey}"
                            Visibility="{Binding ShowMarkControl, Converter={StaticResource Visible}}">
                        <controls:Glyph Style="{StaticResource Hud.Glyph}" Text="{DynamicResource Icon.Flag}" />
                    </Button>
                    <Button Margin="4,0,0,0"
                            Style="{DynamicResource Hud.IconButton}"
                            Command="{Binding PauseOrResumeCommand}"
                            ToolTip="{Binding PauseButton.Tooltip}"
                            AutomationProperties.Name="{Binding PauseButton.Name}"
                            AutomationProperties.AcceleratorKey="{Binding PauseButton.Hotkey}"
                            Visibility="{Binding ShowPauseControl, Converter={StaticResource Visible}}">
                        <controls:Glyph Style="{StaticResource Hud.Glyph}" Text="{Binding PauseGlyph}" />
                    </Button>
                    <!-- 8 from Pause, not 4 (review finding C-H9, design system amendment 24): Stop ends the
                         session in one click, so a slip aimed at Pause should not land on it. -->
                    <Button Margin="8,0,0,0"
                            Style="{DynamicResource Hud.IconButton}"
                            Command="{Binding StopCommand}"
                            ToolTip="{Binding StopButton.Tooltip}"
                            AutomationProperties.Name="{Binding StopButton.Name}"
                            AutomationProperties.AcceleratorKey="{Binding StopButton.Hotkey}"
                            Visibility="{Binding ShowStopControl, Converter={StaticResource Visible}}">
                        <controls:Glyph Style="{StaticResource Hud.Glyph}" Text="{DynamicResource Icon.Stop}" />
                    </Button>
                    <Button Margin="4,0,0,0"
                            Style="{DynamicResource Hud.IconButton}"
                            Command="{Binding ToggleExpandedCommand}"
                            ToolTip="{Binding ExpandName}"
                            AutomationProperties.Name="{Binding ExpandName}">
                        <controls:Glyph Style="{StaticResource Hud.Glyph}" Text="{Binding ExpandGlyph}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Expanded: the session's tool and start, the last three events as kinds and times,
             and Open in ScreenTrail (Spec §5 S2). Its own card under the pill, so it has room: inside the
             44 px pill it was three rows of 11 px text squeezed between the state and the buttons. A HUD a
             customer can see over a technician's shoulder holds no content (INV-10). -->
        <!-- Design system 10.10 (review finding C-H10): 4 below the pill, 16 inside, the float radius, a 1 px
             border.strong edge; the heading in Body strong, then 28 px rows of a 16 px glyph, 8, the event in
             Body and its time in HH:mm at the right, a shell.line rule between them. -->
        <Border x:Name="Card"
                Grid.Row="1"
                Margin="0,4,0,0"
                HorizontalAlignment="Stretch"
                Padding="{DynamicResource Padding.card}"
                CornerRadius="{DynamicResource Radius.float}"
                Background="{DynamicResource Brush.shell.bg}"
                BorderBrush="{DynamicResource Brush.border.strong}"
                BorderThickness="{DynamicResource Thickness.float-edge}"
                RenderOptions.ClearTypeHint="Enabled"
                Visibility="{Binding Expanded, Converter={StaticResource Visible}}">
            <StackPanel>
                <TextBlock Margin="0,0,0,8"
                           Style="{StaticResource Hud.Text}"
                           FontWeight="{DynamicResource Weight.semibold}"
                           Text="{Binding SessionTitle}" />

                <controls:Repeater ItemsSource="{Binding RecentEvents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type hud:HudEventRow}">
                            <Border MinHeight="{DynamicResource Layout.hit-target-min}" BorderBrush="{DynamicResource Brush.shell.line}" BorderThickness="0,1,0,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Glyph Grid.Column="0" Style="{StaticResource Hud.Icon}" Foreground="{DynamicResource Brush.shell.muted}" Text="{Binding Glyph}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,16,0"
                                               Style="{StaticResource Hud.Text}"
                                               Text="{Binding Text}"
                                               AutomationProperties.Name="{Binding Spoken}" />
                                    <!-- The time is already in the row's spoken words beside it, so it is
                                         drawn without a peer of its own rather than read twice. -->
                                    <controls:Glyph Grid.Column="2"
                                                    Style="{StaticResource Hud.Muted}"
                                                    Typography.NumeralAlignment="Tabular"
                                                    Text="{Binding Time}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>

                <!-- Nothing yet: said, rather than an empty card that looks broken. -->
                <Border MinHeight="{DynamicResource Layout.hit-target-min}" BorderBrush="{DynamicResource Brush.shell.line}" BorderThickness="0,1,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecentEvents}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource Hud.Muted}" Text="No events yet" />
                </Border>

                <!-- Open in ScreenTrail only. Mark is not repeated here: the card only ever shows under the
                     pill, whose own Mark button is there in every state the service accepts a mark, and two
                     focusable buttons with one name read as the same control twice to a screen reader
                     (Accessibility Insights, SiblingUniqueAndFocusable). -->
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <!-- Default size, not compact as design system 10.10 says: the pill floats over the remote
                         desktop and its targets are 32, as the audit holds. -->
                    <Button Style="{DynamicResource Button.Secondary}"
                            Command="{Binding ReviewCommand}"
                            Content="Open in ScreenTrail"
                            ToolTip="Open this session in ScreenTrail. It can be edited once the session is stopped."
                            AutomationProperties.Name="Open in ScreenTrail" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
