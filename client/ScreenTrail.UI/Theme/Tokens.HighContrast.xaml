<!-- Spec §7: when Windows high contrast is on, every token maps to the system palette the user chose.
     Same keys as the generated theme dictionaries, so components need no changes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <x:Static x:Key="Token.bg.base" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.bg.base" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.bg.surface" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.bg.surface" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.bg.raised" Member="SystemColors.ControlColor" />
    <SolidColorBrush x:Key="Brush.bg.raised" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <!-- The tints (v0.5) are all the window colour here. A tinted fill is how light and dark show hover,
         selection and a banner's kind; high contrast shows them with the border and the words instead,
         because a system palette has no tint that is guaranteed to keep WindowText readable on it. -->
    <x:Static x:Key="Token.bg.hover" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.bg.hover" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.bg.pressed" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.bg.pressed" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.bg.selected" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.bg.selected" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.bg.warning" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.bg.warning" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.bg.danger" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.bg.danger" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.bg.success" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.bg.success" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.border.subtle" Member="SystemColors.GrayTextColor" />
    <SolidColorBrush x:Key="Brush.border.subtle" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <x:Static x:Key="Token.border.strong" Member="SystemColors.WindowFrameColor" />
    <SolidColorBrush x:Key="Brush.border.strong" Color="{DynamicResource {x:Static SystemColors.WindowFrameColorKey}}" />
    <!-- An input's edge: the same system frame colour the inputs used before border.control existed. -->
    <x:Static x:Key="Token.border.control" Member="SystemColors.WindowFrameColor" />
    <SolidColorBrush x:Key="Brush.border.control" Color="{DynamicResource {x:Static SystemColors.WindowFrameColorKey}}" />
    <x:Static x:Key="Token.text.primary" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.text.primary" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.text.secondary" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.text.secondary" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.text.muted" Member="SystemColors.GrayTextColor" />
    <SolidColorBrush x:Key="Brush.text.muted" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <x:Static x:Key="Token.accent.primary" Member="SystemColors.HighlightColor" />
    <SolidColorBrush x:Key="Brush.accent.primary" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <x:Static x:Key="Token.accent.primary.hover" Member="SystemColors.HotTrackColor" />
    <SolidColorBrush x:Key="Brush.accent.primary.hover" Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" />
    <x:Static x:Key="Token.state.recording" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.state.recording" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.state.paused" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.state.paused" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.state.scope" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.state.scope" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.state.published" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.state.published" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.state.offline" Member="SystemColors.GrayTextColor" />
    <SolidColorBrush x:Key="Brush.state.offline" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <x:Static x:Key="Token.state.danger" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.state.danger" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.confidence.low" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.confidence.low" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.text.on-accent" Member="SystemColors.HighlightTextColor" />
    <SolidColorBrush x:Key="Brush.text.on-accent" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <!-- v0.6.0 brand. The signature is a rule or a mark, so it takes the text colour. The ribbon band and its
         fold are decoration: drawn in the window colour they are not seen, and the selected tab keeps its
         Highlight outline, so nothing depends on them. -->
    <x:Static x:Key="Token.brand.signature" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.brand.signature" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.brand.ribbon.band" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.brand.ribbon.band" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.brand.ribbon.fold" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.brand.ribbon.fold" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <!-- v0.6.0 frame (rail, title bar, pill). High contrast has no frame of its own: it is the window, with
         the window text on it, and each state keeps its word and glyph. -->
    <x:Static x:Key="Token.shell.bg" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.shell.bg" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.shell.hover" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.shell.hover" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.shell.text" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.shell.text" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.shell.muted" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.shell.muted" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.shell.accent" Member="SystemColors.HighlightColor" />
    <SolidColorBrush x:Key="Brush.shell.accent" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <x:Static x:Key="Token.shell.line" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.shell.line" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.shell.recording" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.shell.recording" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.shell.paused" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.shell.paused" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.shell.published" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.shell.published" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.shell.scope" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.shell.scope" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.shell.offline" Member="SystemColors.GrayTextColor" />
    <SolidColorBrush x:Key="Brush.shell.offline" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <sys:String x:Key="Token.theme">high-contrast</sys:String>
    <!-- v0.7.0 (the premium review's design system): the new tints are the window colour, as the others are;
         the new edges and marks are the text colours, so high contrast shows a kind by its border and words. -->
    <x:Static x:Key="Token.bg.info" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.bg.info" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.bg.disabled" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.bg.disabled" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.border.success" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.border.success" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.border.warning" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.border.warning" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.border.danger" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.border.danger" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.text.disabled" Member="SystemColors.GrayTextColor" />
    <SolidColorBrush x:Key="Brush.text.disabled" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <x:Static x:Key="Token.accent.primary.pressed" Member="SystemColors.HotTrackColor" />
    <SolidColorBrush x:Key="Brush.accent.primary.pressed" Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" />
    <x:Static x:Key="Token.brand.frame" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.brand.frame" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <x:Static x:Key="Token.brand.on-frame" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.brand.on-frame" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.state.redacted" Member="SystemColors.WindowTextColor" />
    <SolidColorBrush x:Key="Brush.state.redacted" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <x:Static x:Key="Token.danger.fill" Member="SystemColors.HighlightColor" />
    <SolidColorBrush x:Key="Brush.danger.fill" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <x:Static x:Key="Token.danger.fill.hover" Member="SystemColors.HotTrackColor" />
    <SolidColorBrush x:Key="Brush.danger.fill.hover" Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" />
    <x:Static x:Key="Token.shell.pressed" Member="SystemColors.WindowColor" />
    <SolidColorBrush x:Key="Brush.shell.pressed" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <!-- No shadows in high contrast: a floating surface is told apart by its WindowFrame outline. -->
    <x:Null x:Key="Elevation.popup" />
    <x:Null x:Key="Elevation.float" />
    <!-- A text field's keyboard ring: kept here alone. The field's 2 px edge is Highlight, close in luminance
         to the frame colour, so on a scaled screen the edge alone was too faint to see (ST-084). -->
    <!-- A chosen segment keeps a 2 px Highlight edge: its tint is the window colour here. -->
    <Thickness x:Key="Thickness.selected-edge">2</Thickness>
    <!-- A selected row is the 2 px Highlight edge round it: the bar and the fill are the window colour. -->
    <x:Static x:Key="Token.selection.edge" Member="SystemColors.HighlightColor" />
    <SolidColorBrush x:Key="Brush.selection.edge" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <!-- A skeleton block is outlined in GrayText: its fill is the window colour here, so without an edge a
         drafting note was an empty pane. -->
    <x:Static x:Key="Token.skeleton.edge" Member="SystemColors.GrayTextColor" />
    <SolidColorBrush x:Key="Brush.skeleton.edge" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <!-- A scroll thumb is 8 wide at all times, in the window text colour. -->
    <sys:Double x:Key="ScrollThumb.rest">8</sys:Double>
    <Style x:Key="FocusVisual.input">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="9"
                               RadiusY="9"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Brush.accent.primary}"
                               StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
