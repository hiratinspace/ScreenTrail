<!-- Spec §3 component library. Every colour, size and radius comes from the token dictionaries via
     DynamicResource, so themes swap without touching a component. Keys: "<Component>.<Variant>".

     v0.5 (ST-016, the modern pass): every control has rest, hover, pressed, keyboard-focus and disabled
     looks built from the tokens, and the stock WPF controls the views use without a key (check box, radio,
     combo, list, scroll bar, slider, password box, tool tip) get a keyless style here so no default grey
     Windows 7 chrome is left on a dark window. A disabled control keeps its words in text.muted on
     bg.raised, which is held to 4.5:1, rather than fading the whole thing to 45% opacity. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
                    xmlns:theme="clr-namespace:ScreenTrail.UI.Theme">
    <!-- The icons by concept (design system 8): here, so every window, harness and test that loads the
         components has them too. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Focus ring: 2 px accent 3 px outside the control; WPF shows FocusVisualStyle for keyboard focus only.
         Its radius is the control's plus the 3 px gap, so the ring runs parallel to the edge it circles
         (design system 5, review finding B-32): 9 on the 6 px controls (Radius.control + 3). -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="9"
                               RadiusY="9"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Brush.accent.primary}"
                               StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 7 on the 4 px shapes: check boxes, radio buttons and key caps (Radius.sm + 3). -->
    <Style x:Key="FocusRing.Small">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="7"
                               RadiusY="7"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Brush.accent.primary}"
                               StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Fully round on the pill shapes: toggles and pill toggles. A rectangle clamps the radius to half its
         height, as a Border does for Radius.pill. -->
    <Style x:Key="FocusRing.Pill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="999"
                               RadiusY="999"
                               SnapsToDevicePixels="True"
                               Stroke="{DynamicResource Brush.accent.primary}"
                               StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text (design system 3.2, v0.7.0): one style per role, each with its own size, weight, font and line
         height in pixels (Leading.*, set with BlockLineHeight so lines land on the 4 px grid). No view sets
         its own size or weight on a TextBlock: if a role does not fit, the role is wrong. The v0.6 keys
         (Text.Muted, Text.SectionHeading, Text.TileHeading, Text.ScreenTitle) stay as the roles they became. -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="LineHeight" Value="{DynamicResource Leading.body}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <!-- A line with nothing to say takes no room and is not there for a screen reader: an empty text
             is a zero-sized element that Accessibility Insights fails (ST-084). Every text style is based on
             this one. A visibility bound on the element itself still wins. -->
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Tile and row titles, the rail row title, a line that leads its card: body size, semibold. -->
    <Style x:Key="Text.BodyStrong" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
    </Style>
    <Style x:Key="Text.Secondary" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
    </Style>
    <!-- Hints, timestamps, meta lines. The Small optical size, made for 12 px. -->
    <Style x:Key="Text.Caption" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.small}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="LineHeight" Value="{DynamicResource Leading.caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
    </Style>
    <Style x:Key="Text.Muted" BasedOn="{StaticResource Text.Caption}" TargetType="TextBlock" />
    <!-- A field's name above its control, a table header, a card's header: smaller than the value, and
         quieter, but not a hint (hint grey reads as placeholder text). -->
    <Style x:Key="Text.Label" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.small}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="LineHeight" Value="{DynamicResource Leading.caption}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
    </Style>
    <!-- Strings a machine reads: hotkeys, paths, IDs. 13 px Cascadia Mono has 14 px Segoe UI's x-height. -->
    <Style x:Key="Text.Mono" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.mono}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
    </Style>
    <!-- A Settings section, a note heading, a dialog's question, the pill card's heading. -->
    <Style x:Key="Text.Section" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.lg}" />
        <Setter Property="LineHeight" Value="{DynamicResource Leading.section}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
    </Style>
    <Style x:Key="Text.SectionHeading" BasedOn="{StaticResource Text.Section}" TargetType="TextBlock" />
    <Style x:Key="Text.TileHeading" BasedOn="{StaticResource Text.BodyStrong}" TargetType="TextBlock" />
    <!-- A screen's title (All sessions, Settings), the note's title in the envelope: wayfinding, so quieter
         than the note at 20. Ideal formatting: hinting distorts shapes at 20 px and up. -->
    <Style x:Key="Text.Title" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.display}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.xl}" />
        <Setter Property="LineHeight" Value="{DynamicResource Leading.title}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="Text.ScreenTitle" BasedOn="{StaticResource Text.Title}" TargetType="TextBlock" />
    <!-- The onboarding step's heading, the receipt's figures, an empty state's count: at most one per window. -->
    <Style x:Key="Text.Display" BasedOn="{StaticResource Text.Title}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.2xl}" />
        <Setter Property="LineHeight" Value="{DynamicResource Leading.display}" />
    </Style>
    <Style x:Key="Text.Error" BasedOn="{StaticResource Text.Caption}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
    </Style>
    <!-- Times, durations and counts: tabular lining figures, so digits do not jitter as a timer ticks. -->
    <Style x:Key="Text.Numeric" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Typography.NumeralStyle" Value="Lining" />
    </Style>
    <!-- A Windows icon-font glyph (Segoe Fluent Icons, or MDL2 before Windows 11). Decoration beside
         words that already say the same thing, never the only signal. -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.icon}" />
        <Setter Property="FontSize" Value="{DynamicResource Icon.control}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- An empty or waiting pane (design system issue 1, review finding A-08): no card around it. Centred in
         the free area with 48 above and below (EmptyState); a 56 px pill disc in bg.info (EmptyState.Disc)
         holding the 32 px glyph in text.secondary (EmptyState.Icon), never Iris art; the message in Body
         text.primary, at most 400 wide, 16 below the disc (EmptyState.Message); an action as a Link 8 below.
         The rail's is the same parts at 40 and 20, left aligned with the rows' words (the .Rail keys). -->
    <Style x:Key="EmptyState" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,48" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="{DynamicResource Layout.empty-max-width}" />
    </Style>
    <Style x:Key="EmptyState.Disc" TargetType="Border">
        <Setter Property="Width" Value="{DynamicResource Layout.empty-disc}" />
        <Setter Property="Height" Value="{DynamicResource Layout.empty-disc}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.info}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.pill}" />
    </Style>
    <Style x:Key="EmptyState.Icon" BasedOn="{StaticResource Icon}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Icon.hero}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="EmptyState.Message" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="EmptyState.Disc.Rail" BasedOn="{StaticResource EmptyState.Disc}" TargetType="Border">
        <Setter Property="Width" Value="{DynamicResource Layout.empty-disc-rail}" />
        <Setter Property="Height" Value="{DynamicResource Layout.empty-disc-rail}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="EmptyState.Icon.Rail" BasedOn="{StaticResource EmptyState.Icon}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Icon.lg}" />
    </Style>

    <!-- Buttons (design system 10.1, v0.7.0): one template and one base under every style, so a state means
         the same on each. Pressed darkens the fill and never changes the label or fades (review findings
         A-32, B-02). Disabled is its own fill and label colour, never an opacity, and never a look one
         edge away from Secondary (A-13). The reason a button is disabled goes beside it as text (v0.4.3),
         and in its ToolTip for the mouse. Default 32 high, 12 px sides, 72 wide at least; theme:Density.Compact
         makes it 28, 8 and 56 (B-03). A shortcut inside a button is Text.KeyHint after the label, 8 apart,
         and stays out of AutomationProperties.Name (it goes in AcceleratorKey, E-22). -->
    <ControlTemplate x:Key="Button.Template" TargetType="ButtonBase">
        <Border x:Name="Chrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource Radius.control}"
                SnapsToDevicePixels="True">
            <!-- A grid, not a stack panel, so a label in a narrow button is still measured to its room and trims. -->
            <Grid Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- The leading icon (theme:ButtonIcon.Leading), in the label's colour; not there when unset. -->
                <controls:Glyph x:Name="Leading"
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                Style="{StaticResource Icon}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding theme:ButtonIcon.Leading}" />
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="theme:ButtonIcon.Leading" Value="{x:Null}">
                <Setter TargetName="Leading" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- What every button shares. Not used on its own: a button is one of the styles below. -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="MinWidth" Value="{DynamicResource Layout.button-min-width}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.control}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.regular}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource Thickness.border}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
        <Style.Triggers>
            <Trigger Property="theme:Density.Compact" Value="True">
                <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height-compact}" />
                <Setter Property="MinWidth" Value="{DynamicResource Layout.button-min-width-compact}" />
                <Setter Property="Padding" Value="{DynamicResource Padding.control-compact}" />
            </Trigger>
            <!-- The shared disabled look, for the styles with a fill: Primary, Secondary, DangerSolid. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.disabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Secondary" BasedOn="{StaticResource Button.Base}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Primary" BasedOn="{StaticResource Button.Base}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.on-accent}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.accent.primary.hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary.hover}" />
            </Trigger>
            <!-- Its own pressed colour (v0.7.0), not the rest fill at 85%: the fade let the card show through
                 and looked lighter than hover. -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.accent.primary.pressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary.pressed}" />
            </Trigger>
            <!-- Neutral when disabled, the way Windows 11 does it: a faded accent reads as "primary, but
                 broken". Repeated after hover and pressed so it wins over both. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.disabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
            </Trigger>
            <!-- Loading (theme:Busy.Active): the work is on its way, so the button keeps its fill while it
                 cannot be pressed again (review finding B-46). Last, so it wins over disabled. -->
            <Trigger Property="theme:Busy.Active" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.on-accent}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Ghost: no fill and no edge at rest. Hover fills, and no box appears (a border growing on hover is
         the flat WinForms button). Disabled is the label alone, in text.disabled. -->
    <Style x:Key="Button.Ghost" BasedOn="{StaticResource Button.Base}" TargetType="Button">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Danger: an entry point to something destructive (Discard in Review, Bulk discard, Delete
         everything). Red words with no fill at rest, so it is plainly the destructive one without being
         the loudest thing on the screen; hover and pressed take the danger tint, and the words stay red
         throughout (review finding B-01: built on Secondary, the label went grey at the click). Built on
         the base, so no Secondary trigger can leak into it. -->
    <Style x:Key="Button.Danger" BasedOn="{StaticResource Button.Base}" TargetType="Button">
        <Setter Property="theme:ButtonIcon.Leading" Value="{StaticResource Icon.Delete}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.danger}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.danger}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.danger}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.state.danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- DangerSolid: the confirm button of a destructive dialog only (Discard session, Delete everything),
         once it can be pressed. The decisive act was a thin red outline beside the safe button, weaker than
         it (review finding B-05); benchmarks fill it. The safe button beside it is Secondary and keeps the
         initial focus. Until the phrase is typed it has the shared disabled look. In high contrast the fill
         is Highlight and the words HighlightText. -->
    <Style x:Key="Button.DangerSolid" BasedOn="{StaticResource Button.Base}" TargetType="Button">
        <Setter Property="theme:ButtonIcon.Leading" Value="{StaticResource Icon.Delete}" />
        <Setter Property="Background" Value="{DynamicResource Brush.danger.fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.danger.fill}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.on-accent}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.danger.fill.hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.danger.fill.hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.danger.fill.hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.danger.fill.hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.disabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Icon (design system 10.1): a square button holding one glyph, 32 x 32 (compact 28 x 28), no fill or
         edge at rest, the glyph 16 px in text.secondary. Its Content is the icon itself
         (Content="{StaticResource Icon.Settings}"), drawn in the icon font. Every icon button has a ToolTip
         and an AutomationProperties.Name, since the glyph says nothing to a screen reader. -->
    <Style x:Key="Button.Icon" BasedOn="{StaticResource Button.Base}" TargetType="Button">
        <Setter Property="MinWidth" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.icon}" />
        <Setter Property="FontSize" Value="{DynamicResource Icon.control}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
        <Style.Triggers>
            <Trigger Property="theme:Density.Compact" Value="True">
                <Setter Property="MinWidth" Value="{DynamicResource Layout.control-height-compact}" />
                <Setter Property="Padding" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Input / Search (design system 10.2). The validation message is a line below, never a dialog. Focus is
         a 2 px accent edge drawn over the 1 px one, so the text never moves (review finding B-09: the border
         thickened from 1 to 2 and the text shifted 1 px right and down), and no second ring sits outside it.
         High contrast keeps a ring too (FocusVisual.input, from the theme's dictionary): there the edge alone
         was too faint on a scaled screen, since the frame and highlight colours are close in luminance
         (ST-084, the laptop's run). One template serves every text field; the styles set its colours. -->
    <ControlTemplate x:Key="Input.Template" TargetType="TextBox">
        <!-- Two rows, the field and its error line: a grid, so a tall multiline field still stretches. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Border x:Name="Chrome"
                        MinHeight="{TemplateBinding MinHeight}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource Radius.control}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <!-- The example in an empty field (theme:Field.Placeholder, review finding B-13): where the
                             text starts, in text.muted, gone once anything is typed. Drawn, not read: the field's
                             label and help text say what it is for. -->
                        <TextBlock x:Name="Placeholder"
                                   Margin="{TemplateBinding Padding}"
                                   Padding="2,0,0,0"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Foreground="{DynamicResource Brush.text.muted}"
                                   IsHitTestVisible="False"
                                   Text="{TemplateBinding theme:Field.Placeholder}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </Border>
                <Border x:Name="FocusEdge"
                        BorderBrush="{DynamicResource Brush.accent.primary}"
                        BorderThickness="{DynamicResource Thickness.focus}"
                        CornerRadius="{DynamicResource Radius.control}"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True"
                        Visibility="Collapsed" />
                <!-- A field that is wrong looks wrong (theme:Field.Error or HasError, review finding B-12), over the
                     focus edge so it stays red while the technician fixes it. -->
                <Border x:Name="ErrorEdge"
                        BorderBrush="{DynamicResource Brush.state.danger}"
                        BorderThickness="{DynamicResource Thickness.focus}"
                        CornerRadius="{DynamicResource Radius.control}"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True"
                        Visibility="Collapsed" />
            </Grid>
            <!-- The error line, 4 below its field: the warning glyph 12 and the words, so it is not red alone. -->
            <StackPanel x:Name="ErrorLine" Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
                <controls:Glyph Style="{StaticResource Icon}"
                                VerticalAlignment="Top"
                                Margin="0,2,4,0"
                                FontSize="{DynamicResource Icon.sm}"
                                Foreground="{DynamicResource Brush.state.danger}"
                                Text="{StaticResource Icon.Warning}" />
                <TextBlock Style="{StaticResource Text.Error}" Text="{TemplateBinding theme:Field.Error}" />
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusEdge" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="theme:Field.HasError" Value="True">
                <Setter TargetName="ErrorEdge" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="theme:Field.Error" Value="{x:Null}">
                <Setter TargetName="ErrorLine" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="theme:Field.Error" Value="">
                <Setter TargetName="ErrorLine" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Input.Default" TargetType="TextBox">
        <!-- A minimum, not a height (review finding B-11): with the Windows text size applied (design system
             11) a fixed 32 clipped the line. Centred where a fixed height used to centre it. -->
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.control}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Thickness.border}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.input}" />
        <Setter Property="Template" Value="{StaticResource Input.Template}" />
        <Style.Triggers>
            <!-- The error is said with the field: its UI Automation item status. -->
            <Trigger Property="theme:Field.HasError" Value="True">
                <Setter Property="AutomationProperties.ItemStatus" Value="{Binding (theme:Field.Error), RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <!-- Hover darkens the edge and leaves the fill (review finding B-10): a grey fill is what the
                 disabled look is made of, so a hovered field looked switched off. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.text.muted}" />
            </Trigger>
            <!-- The focus fill is the rest fill: white in light, so the field does not change colour as well. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.disabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Multiline: the note's own fields, which are prose and grow. Input.Default fixes a height and
         centres its content, which turns a three-line step into one clipped line. -->
    <Style x:Key="Input.Multiline" BasedOn="{StaticResource Input.Default}" TargetType="TextBox">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <!-- In place (Spec v0.6.0 §5 S3, "The note is edited in place as it will land"): the note's own text,
         read as the ticket will show it. At rest it is the text on the pane inside a faint 1 px edge
         (v0.6.8, owner decision: a field that looked like plain text until it was focused did not say it
         could be typed in). The edge is border.strong, the quiet one the secondary buttons carry: 1.75:1
         on the light pane and 1.53:1 on the dark, seen but well under the 3:1 control edge, so the note
         still reads as a note. Hover shows the control edge (border.control), and focus is the accent
         outline at 2 px and the focus ring, as on every other field. High contrast maps all three to
         system colours. -->
    <Style x:Key="Input.InPlace" BasedOn="{StaticResource Input.Multiline}" TargetType="TextBox">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.control}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
            </Trigger>
        </Style.Triggers>
</Style>

    <!-- A step's frame on its row (Spec v0.6.0 §5 S3): the thumbnail is the button. Its edge is the control
         edge, so the picture reads as something to press, and hover and press tint it like a chip. -->
    <Style x:Key="StepFrame" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The typed confirmations: a phrase to copy exactly, so it is set in the monospace face. -->
    <Style x:Key="Input.Mono" BasedOn="{StaticResource Input.Default}" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.mono}" />
    </Style>

    <!-- Check box: an 18 px rounded box with a drawn tick, filled with the accent when on. -->
    <Style TargetType="CheckBox">
        <!-- Its own width, not the card's, so the focus ring hugs the box and label (review finding B-19). -->
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.text.muted}" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Small}" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- Design system 10.3 (review finding B-18): an 18 px box, radius 4, with every state a
                     Windows check box has. Off: hover darkens the edge and tints the fill, pressed is bg.pressed.
                     On: accent, hover and pressed step darker. The tick is the icon font's check, 12 in
                     text.on-accent. Disabled is the disabled triple, and the tick stays so a locked setting
                     still says which way it is set. -->
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="{DynamicResource Layout.choice-mark}"
                                Height="{DynamicResource Layout.choice-mark}"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{DynamicResource Thickness.border}"
                                CornerRadius="{DynamicResource Radius.sm}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <controls:Glyph x:Name="Tick"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Icon}"
                                                FontSize="{DynamicResource Icon.sm}"
                                                Foreground="{DynamicResource Brush.text.on-accent}"
                                                Text="{StaticResource Icon.Check}"
                                                Visibility="Collapsed" />
                                <Rectangle x:Name="Dash"
                                           Width="8"
                                           Height="2"
                                           Fill="{DynamicResource Brush.text.on-accent}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.text.secondary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.accent.primary.hover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary.hover}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.accent.primary.pressed}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary.pressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.bg.disabled}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                            <Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
                            <Setter TargetName="Dash" Property="Fill" Value="{DynamicResource Brush.text.disabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio: an 18 px circle; on is an accent disc around a dot in the on-accent colour, with the same
         states as the check box (design system 10.3, review finding B-18). -->
    <Style TargetType="RadioButton">
        <!-- Its own width, not the card's, so the focus ring hugs the box and label (review finding B-19). -->
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.text.muted}" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Small}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="{DynamicResource Layout.choice-mark}" Height="{DynamicResource Layout.choice-mark}" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="Dot"
                                     Width="8"
                                     Height="8"
                                     Fill="{DynamicResource Brush.text.on-accent}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.bg.hover}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.text.secondary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.bg.pressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.accent.primary.hover}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.accent.primary.hover}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.accent.primary.pressed}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.accent.primary.pressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.bg.disabled}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.border.subtle}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.text.disabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segment: one choice of a segmented control (Spec v0.6.0 §5 S3, the envelope's As line). Radio
         buttons in a Segment.Group, so the choice is visible and one key press away. Design system 10.3
         (review findings A-19, B-21): the group is 32 high, radius 6, a 1 px border.strong edge and 2 inside;
         each segment is 26 high, radius 4 (6 less the 2), 12 at the sides, so the corners nest. The chosen
         one is the selection tint with its words in semibold text.primary, the others text.secondary: one
         signal, no underline. In high contrast the tint is the window colour, so the chosen one keeps a 2 px
         Highlight edge (Thickness.selected-edge). -->
    <Style x:Key="Segment.Group" TargetType="Border">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Thickness.border}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.control}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.regular}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <!-- Drawn 26 high inside the group's 2 px inset (design system 10.3), but at least a 28 px target
             (Spec 7): the segment reaches across the inset above and below, 30 high, and its chrome is drawn
             2 px in. -->
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Margin" Value="0,-2" />
        <Setter Property="Padding" Value="{DynamicResource Padding.control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Chrome"
                                Margin="0,2"
                                MinHeight="{DynamicResource Layout.segment-height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.accent.primary}"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource Radius.sm}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.selected}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="{DynamicResource Thickness.selected-edge}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                            <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check chip: a destination in the envelope's Also line, a check box drawn as a bordered chip with its
         box inside, so each destination reads as a value that is on or off. Design system 10.5 (review
         findings A-18, B-20): the chip is 32 high, radius 6, 8 before the mark and 12 after the words, with a
         border.strong edge; the mark is the check box's 18 px square of radius 4, not a 16 px near-circle that
         read as a radio. On, the whole chip takes the selection tint. Hover and pressed are the Secondary
         button's. -->
    <Style x:Key="CheckChip" BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="Padding" Value="8,0,12,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Chrome"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{DynamicResource Brush.bg.raised}"
                            BorderBrush="{DynamicResource Brush.border.strong}"
                            BorderThickness="{DynamicResource Thickness.border}"
                            CornerRadius="{DynamicResource Radius.control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="{DynamicResource Layout.choice-mark}"
                                    Height="{DynamicResource Layout.choice-mark}"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{DynamicResource Thickness.border}"
                                    CornerRadius="{DynamicResource Radius.sm}">
                                <controls:Glyph x:Name="Tick"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Icon}"
                                                FontSize="{DynamicResource Icon.sm}"
                                                Foreground="{DynamicResource Brush.text.on-accent}"
                                                Text="{StaticResource Icon.Check}"
                                                Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.selected}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.disabled}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.bg.disabled}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                            <Setter TargetName="Tick" Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A shortcut shown one of two ways, never typed into a button's Content with spaces (design system
         10.1 and 10.5; review findings A-14, B-08, E-22). Inside the button it presses ("Publish  Ctrl+Enter",
         "Save  Ctrl+S"): Text.KeyHint 8 after the label, in the label's colour. Beside a link or toggle it
         belongs to ("Change  Ctrl+T", "Timeline  Alt+T"): a KeyCap 4 after the control. Either way the key
         stays out of the control's AutomationProperties.Name and goes in AcceleratorKey, so Narrator reads
         "Save", not "Save Ctrl+S". -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.keycap-height}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Thickness.border}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.sm}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.text.secondary}" />
    </Style>
    <!-- Micro (design system 3.2): 11/16 semibold. The foreground is inherited, so inside a filled button it
         is the on-accent colour and inside a key cap the cap's. -->
    <Style x:Key="Text.KeyHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.small}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.xs}" />
        <Setter Property="LineHeight" Value="{DynamicResource Leading.micro}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Combo box (read-only, the only kind the views use): the input's chrome, a chevron, and a raised
         surface for the list. -->
    <Style x:Key="ComboBox.Toggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <!-- The chevron is the icon font's, 12 px, 12 from the right (review finding B-17). -->
                        <controls:Glyph Margin="0,0,12,0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource Icon}"
                                        FontSize="{DynamicResource Icon.sm}"
                                        Text="{StaticResource Icon.ChevronDown}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A choice in the open list (design system 10.2): 32 high, radius 4, 8 px sides. Hover is bg.hover;
         the chosen one is bg.selected with a check at the right, not an Iris bar (review finding B-17). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.control-compact}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.sm}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                            <controls:Glyph x:Name="Check"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource Icon}"
                                            FontSize="{DynamicResource Icon.sm}"
                                            Foreground="{DynamicResource Brush.accent.primary}"
                                            Text="{StaticResource Icon.Check}"
                                            Visibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.selected}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="MaxDropDownHeight" Value="{DynamicResource Layout.dropdown-max-height}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" MinHeight="{TemplateBinding MinHeight}">
                        <ToggleButton x:Name="Toggle"
                                      Style="{StaticResource ComboBox.Toggle}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <!-- 12 from the left, where a text box's text starts, and clear of the chevron. -->
                        <ContentPresenter Margin="12,0,40,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <!-- The open list is a level 2 surface (design system 6, review finding B-17): the popup
                             shadow on an empty sibling border, never on the one holding text (it would lose
                             ClearType), inside 24 px of transparent margin the shadow draws into. The offsets put
                             the list 4 below the field, its left edge on the field's. No shadow in high contrast. -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               HorizontalOffset="-24"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="None"
                               VerticalOffset="-20">
                            <Grid Margin="24">
                                <Border Background="{DynamicResource Brush.bg.surface}"
                                        CornerRadius="{DynamicResource Radius.card}"
                                        Effect="{DynamicResource Elevation.popup}" />
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="4"
                                        Background="{DynamicResource Brush.bg.surface}"
                                        BorderBrush="{DynamicResource Brush.border.strong}"
                                        BorderThickness="{DynamicResource Thickness.border}"
                                        CornerRadius="{DynamicResource Radius.card}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                        <!-- Open, the field takes the 2 px accent edge; closed, focus is the ring alone. -->
                        <Border x:Name="FocusEdge"
                                BorderBrush="{DynamicResource Brush.accent.primary}"
                                BorderThickness="{DynamicResource Thickness.focus}"
                                CornerRadius="{DynamicResource Radius.control}"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"
                                Visibility="Collapsed" />
                        <Border x:Name="ErrorEdge"
                                BorderBrush="{DynamicResource Brush.state.danger}"
                                BorderThickness="{DynamicResource Thickness.focus}"
                                CornerRadius="{DynamicResource Radius.control}"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"
                                Visibility="Collapsed" />
                    </Grid>
                    <StackPanel x:Name="ErrorLine" Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
                        <controls:Glyph Style="{StaticResource Icon}"
                                        VerticalAlignment="Top"
                                        Margin="0,2,4,0"
                                        FontSize="{DynamicResource Icon.sm}"
                                        Foreground="{DynamicResource Brush.state.danger}"
                                        Text="{StaticResource Icon.Warning}" />
                        <TextBlock Style="{StaticResource Text.Error}" Text="{TemplateBinding theme:Field.Error}" />
                    </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="theme:Field.HasError" Value="True">
                            <Setter TargetName="ErrorEdge" Property="Visibility" Value="Visible" />
                            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding (theme:Field.Error), RelativeSource={RelativeSource Self}}" />
                        </Trigger>
                        <Trigger Property="theme:Field.Error" Value="{x:Null}">
                            <Setter TargetName="ErrorLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="theme:Field.Error" Value="">
                            <Setter TargetName="ErrorLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- A combo is a button too, so hover fills it as well as darkening the edge (design
                             system 10.2), and a press darkens the fill (the toggle's own trigger). -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Toggle" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.text.muted}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusEdge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List box and its rows, wherever a view uses one without a style of its own (ticket matches, the
         transcript). Selection is a tint plus an accent bar at the left edge, so it survives high contrast,
         where the tint is the window colour. -->
    <!-- The selection bar (design system 10.4, review finding A-01): one mark for every selected row, a 3 x 16
         pill in brand.ribbon.band at the row's leading edge, centred, over the selected fill. Rows show it
         by name (Indicator) when selected; it is never hit-tested. -->
    <Style x:Key="SelectionBar" TargetType="Rectangle">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="{DynamicResource Icon.control}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RadiusX" Value="1.5" />
        <Setter Property="RadiusY" Value="1.5" />
        <Setter Property="Fill" Value="{DynamicResource Brush.brand.ribbon.band}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>
    <!-- And its edge (design system 12, review findings A-35, E-28): 2 px Highlight all round the selected row
         in high contrast, nothing in light and dark. Rows show it by name (Edge) when selected. -->
    <Style x:Key="SelectionEdge" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.selection.edge}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Thickness.selected-edge}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Rectangle x:Name="Indicator" Style="{StaticResource SelectionBar}" />
                        <Border x:Name="Edge" Style="{StaticResource SelectionEdge}" CornerRadius="4" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.selected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bars: a slim rounded thumb on a clear track. The default is a light grey bar that sat
         on every dark pane like a stripe of white paint. -->
    <!-- A track's page areas are PageButtons: repeat buttons UI Automation does not list as controls, since
         a screen reader scrolls through the pane's Scroll pattern (ST-084). -->
    <Style x:Key="ScrollBar.Page" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ProgressRing (design system 10.8): a 16 px three-quarter ring in its foreground, turning once a
         second while it is shown; the one thing allowed to loop. Not focusable: the words beside it say what
         is happening. It appears after 300 ms of waiting, so a fast answer never flashes it. Both from code
         (theme:Waiting), never a storyboard, so reduce motion holds the ring still. -->
    <Style x:Key="ProgressRing" TargetType="Control">
        <Setter Property="Width" Value="{DynamicResource Icon.control}" />
        <Setter Property="Height" Value="{DynamicResource Icon.control}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Viewbox x:Name="Ring" Opacity="0" theme:Waiting.Appear="True">
                        <Path x:Name="Arc"
                              theme:Waiting.Spin="True"
                              Width="16"
                              Height="16"
                              Data="M 8,1.5 A 6.5,6.5 0 1 1 1.5,8"
                              RenderTransformOrigin="0.5,0.5"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="2">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="Spin" />
                            </Path.RenderTransform>
                        </Path>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Skeleton (design system 10.8): a flat bg.hover block, radius 4, no shimmer and no pulse (a moving
         gradient breaks the flat-fill rule and distracts beside a remote session). A text line is a block 12
         high in a 20 px line. It appears only after 300 ms of waiting, so a fast answer never flashes it
         (theme:Waiting.Appear, from code). Skeleton.Frame is the same on the rail, in shell.hover. -->
    <Style x:Key="Skeleton" TargetType="Border">
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.sm}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="theme:Waiting.Appear" Value="True" />
    </Style>
    <Style x:Key="Skeleton.Frame" BasedOn="{StaticResource Skeleton}" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.shell.hover}" />
    </Style>

    <!-- The thumb (design system 10.8, review findings A-33, B-29): a 4 px pill in border.strong at rest, so
         a scrolling area does not add a full-strength line beside every list; 8 wide in text.muted while the
         pointer is over its track or it is held (text.secondary), at least 32 long. In high contrast it is 8
         wide at all times (ScrollThumb.rest). -->
    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.scroll-thumb-min}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar"
                                Width="{DynamicResource ScrollThumb.rest}"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.border.strong}"
                                CornerRadius="{DynamicResource Radius.pill}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <Setter TargetName="Bar" Property="Width" Value="{DynamicResource Layout.scroll-thumb-hover}" />
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.text.muted}" />
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Width" Value="{DynamicResource Layout.scroll-thumb-hover}" />
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.text.secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBar.Thumb.Horizontal" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="MinWidth" Value="{DynamicResource Layout.scroll-thumb-min}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar"
                                Height="{DynamicResource ScrollThumb.rest}"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.border.strong}"
                                CornerRadius="{DynamicResource Radius.pill}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <Setter TargetName="Bar" Property="Height" Value="{DynamicResource Layout.scroll-thumb-hover}" />
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.text.muted}" />
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Height" Value="{DynamicResource Layout.scroll-thumb-hover}" />
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.text.secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="ScrollBar.Vertical" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <controls:PageButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBar.Page}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <controls:PageButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBar.Page}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="ScrollBar.Horizontal" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <controls:PageButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBar.Page}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.Thumb.Horizontal}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <controls:PageButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBar.Page}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template" Value="{StaticResource ScrollBar.Vertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template" Value="{StaticResource ScrollBar.Horizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Slider: a 4 px rounded track, the accent up to an 18 px thumb. Horizontal, as every slider here is. -->
    <!-- The slider (design system 10.3, review finding B-23): a 4 px border.strong track of radius 2, the
         accent fill left of a 16 px accent thumb with a 2 px bg.surface ring, so the thumb stands clear of the
         fill. Hover and pressed step the thumb darker; it never changes size. Disabled, a setting the admin
         set, the fill and the thumb are text.disabled, so a locked value is not drawn in Iris. -->
    <Style x:Key="Slider.Fill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Fill"
                                Height="{DynamicResource Layout.track-height}"
                                Margin="8,0,-8,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.accent.primary}"
                                CornerRadius="{DynamicResource Radius.xs}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.text.disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Knob"
                             Width="{DynamicResource Layout.slider-thumb}"
                             Height="{DynamicResource Layout.slider-thumb}"
                             Fill="{DynamicResource Brush.accent.primary}"
                             Stroke="{DynamicResource Brush.bg.surface}"
                             StrokeThickness="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.accent.primary.hover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.accent.primary.pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.text.disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="{DynamicResource Layout.track-height}" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource Brush.border.strong}" CornerRadius="{DynamicResource Radius.xs}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <controls:PageButton Command="Slider.DecreaseLarge" Style="{StaticResource Slider.Fill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Slider.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <controls:PageButton Command="Slider.IncreaseLarge" Style="{StaticResource ScrollBar.Page}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tool tip: a small raised surface that wraps, in the app's type rather than the system's. -->
    <!-- Tooltip (design system 10.6, review finding B-28): a level 2 surface, radius 4, 8 at the sides and
         4 above and below, Caption size in text.primary, at most 320 wide and wrapping. The popup shadow is on
         an empty border behind the words (never on the one holding them, which would lose ClearType), inside
         a transparent margin it draws into; the offsets put the tip 4 below its control, left edges aligned.
         The system's own shadow is off. Timing (600 ms to show) is ToolTipTiming's. -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource Font.small}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="MaxWidth" Value="{DynamicResource Layout.tooltip-max-width}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="HorizontalOffset" Value="-8" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Margin="8,0,8,12">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.sm}"
                                Effect="{DynamicResource Elevation.popup}" />
                        <Border Padding="8,4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{DynamicResource Thickness.border}"
                                CornerRadius="{DynamicResource Radius.sm}"
                                RenderOptions.ClearTypeHint="Enabled">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Badge (design system 10.5, review findings A-02, B-24): one style with a tone (theme:Badge.Tone), 20
         high, a pill, 8 at the sides, a 1 px edge, an optional 12 px glyph 4 before the words
         (theme:Badge.Glyph), and the words in Micro text.primary. Neutral is bg.info and border.subtle; each
         other tone takes its tint, its soft border.* edge (not the full-strength state colour) and its glyph
         colour. Not interactive, no hover. It replaces Badge.Suggested, .Confidence, .Published,
         .Unconfirmed, .State and Rail.Badge, so one state is drawn one way wherever it is shown. -->
    <Style x:Key="Badge" TargetType="ContentControl">
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.xs}" />
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.info}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.badge-height}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.control-compact}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Chrome"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{DynamicResource Thickness.border}"
                            CornerRadius="{DynamicResource Radius.pill}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <controls:Glyph x:Name="Glyph"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Icon}"
                                            FontSize="{DynamicResource Icon.sm}"
                                            Foreground="{DynamicResource Brush.text.secondary}"
                                            Text="{TemplateBinding theme:Badge.Glyph}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="theme:Badge.Glyph" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="theme:Badge.Glyph" Value="">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="theme:Badge.Tone" Value="Accent">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.selected}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.accent.primary}" />
                        </Trigger>
                        <Trigger Property="theme:Badge.Tone" Value="Success">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.success}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.success}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.state.published}" />
                        </Trigger>
                        <Trigger Property="theme:Badge.Tone" Value="Warning">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.warning}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.warning}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.state.paused}" />
                        </Trigger>
                        <Trigger Property="theme:Badge.Tone" Value="Danger">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.danger}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.danger}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
                        </Trigger>
                        <Trigger Property="theme:Badge.Tone" Value="Scope">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.state.scope}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- State dot: colour as indicator (Spec §2.1 v0.4.2), always next to a text label -->
    <Style x:Key="StateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.state.recording}" />
    </Style>

    <!-- Meter.Level: the microphone's live level in Settings, Capture (ST-080 AC3, Spec §5 S5). Design system
         10.8 (review finding B-30): a 4 px line of radius 2 with no edge, the track border.subtle and the fill
         state.published, amber (state.paused) while the voice clips (theme:Meter.Clipping). Not focusable,
         since there is nothing to do with it; its words are beside it, never only the bar. -->
    <Style x:Key="Meter.Level" TargetType="ProgressBar">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Width" Value="{DynamicResource Layout.meter-width}" />
        <Setter Property="Height" Value="{DynamicResource Layout.track-height}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{DynamicResource Brush.border.subtle}" CornerRadius="{DynamicResource Radius.xs}">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource Brush.state.published}" CornerRadius="{DynamicResource Radius.xs}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="theme:Meter.Clipping" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Background" Value="{DynamicResource Brush.state.paused}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Banner (design system 10.6, review findings A-11, A-12, B-26): inline at the top of what it is about.
         One control with a tone (theme:Banner.Tone: Info, Success, Warning, Danger): radius 8, a 1 px soft
         edge, 12 inside, the tone's 16 px glyph at the left with its top 2 below the first line's and 8
         before the words, an optional Body strong title (theme:Banner.Title) 4 above the body, and the body
         in text.primary. Info is bg.info with a text.secondary glyph, never the selection tint or Iris, so
         it is not taken for a selected row. Warning's edge is border.warning, not the full amber. The glyph
         is the icon font's, never a Unicode sign in the text face. No side stripe, no hover. Actions sit in
         the content at the right or below. -->
    <Style x:Key="Banner" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.info}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{DynamicResource Thickness.border}"
                            CornerRadius="{DynamicResource Radius.card}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:Glyph x:Name="Glyph"
                                            Grid.Column="0"
                                            Margin="0,2,8,0"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource Icon}"
                                            FontSize="{DynamicResource Icon.control}"
                                            Foreground="{DynamicResource Brush.text.secondary}"
                                            Text="{TemplateBinding theme:Banner.Glyph}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="Title"
                                           Margin="0,0,0,4"
                                           Style="{StaticResource Text.BodyStrong}"
                                           TextWrapping="Wrap"
                                           Text="{TemplateBinding theme:Banner.Title}" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="theme:Banner.Glyph" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Icon.Info}" />
                        </Trigger>
                        <Trigger Property="theme:Banner.Tone" Value="Success">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.success}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.success}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.state.published}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="theme:Banner.Tone" Value="Success" />
                                <Condition Property="theme:Banner.Glyph" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Icon.Check}" />
                        </MultiTrigger>
                        <Trigger Property="theme:Banner.Tone" Value="Warning">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.warning}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.warning}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.state.paused}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="theme:Banner.Tone" Value="Warning" />
                                <Condition Property="theme:Banner.Glyph" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Icon.Warning}" />
                        </MultiTrigger>
                        <Trigger Property="theme:Banner.Tone" Value="Danger">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.danger}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.danger}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.state.danger}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="theme:Banner.Tone" Value="Danger" />
                                <Condition Property="theme:Banner.Glyph" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Icon.Warning}" />
                        </MultiTrigger>
                        <Trigger Property="theme:Banner.Glyph" Value="">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="theme:Banner.Title" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toast (design system 6 level 3 and 10.6, review findings A-28, B-27, D-18): bg.surface, a 1 px
         border.strong edge, radius 8, 16 before the words and 12 elsewhere, 280 to 420 wide. The shadow is
         Elevation.float (#0F1720 at 0.18, black at 0.50 in dark, none in high contrast) on an empty border
         behind the content, never on the one holding the words and the Undo button, which would render them
         to a bitmap and lose ClearType. -->
    <Style x:Key="Toast" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="Padding" Value="16,12,12,12" />
        <Setter Property="MinWidth" Value="{DynamicResource Layout.toast-min-width}" />
        <Setter Property="MaxWidth" Value="{DynamicResource Layout.toast-max-width}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="Shadow"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.card}"
                                Effect="{DynamicResource Elevation.float}" />
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{DynamicResource Thickness.border}"
                                CornerRadius="{DynamicResource Radius.card}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card: a layer above the window, outlined rather than shadowed. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.card}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.card}" />
    </Style>
    <!-- A Settings tile (v0.7.0, owner: Windows 11 style): one setting or one small group of them, a
         compact surface with a 4 px gap to the next, so a section reads as a stack of separate tiles rather
         than one long card each. -->
    <Style x:Key="Settings.Tile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.control}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <!-- Pane: one of Review's three columns, a card with no outer margin of its own. -->
    <Style x:Key="Pane" BasedOn="{StaticResource Card}" TargetType="Border">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Settings (Spec v0.6.0, Settings layout): the section nav, the "Changed" mark, the bar's link and
         the one Save bar. Tokens only; in high contrast each takes the system colours through them, and
         every state keeps its words and its mark. -->
    <Style x:Key="Settings.Nav" BasedOn="{StaticResource {x:Type ListBox}}" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    </Style>
    <!-- A nav row (design system 10.4, review finding B-44): 32 high whether or not it holds a count (the
         20 px badge fits, so no row grows when a change appears), radius 6, 12 at the sides, rows 2 apart.
         Its words in text.secondary at rest; selected, bg.selected with the selection bar and the name in
         Body strong text.primary (Settings.NavLabel). Its name is read with the count of its changes. -->
    <Style x:Key="Settings.NavItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.nav-row-height}" />
        <Setter Property="Height" Value="{DynamicResource Layout.nav-row-height}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        <Setter Property="theme:Pressed.Track" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.control}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Rectangle x:Name="Indicator" Style="{StaticResource SelectionBar}" />
                        <Border x:Name="Edge" Style="{StaticResource SelectionEdge}" CornerRadius="{DynamicResource Radius.control}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                        </Trigger>
                        <Trigger Property="theme:Pressed.IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.selected}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A nav row's name: text.secondary at rest, Body strong text.primary on the selected row. -->
    <Style x:Key="Settings.NavLabel" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A change not yet saved, beside a card's heading (design system 10.5 and issue 8, review finding B-25):
         the Neutral badge with a 6 px text.secondary dot 4 before "Changed". Not Iris: on a page full of
         pending changes, the Save bar's Primary button is the one Iris call. The nav's count is the plain
         Neutral badge with the number alone. -->
    <Style x:Key="Badge.Changed" BasedOn="{StaticResource Badge}" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{DynamicResource Thickness.border}"
                            CornerRadius="{DynamicResource Radius.pill}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,4,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.text.secondary}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Link (design system 10.1, review finding B-07): accent words with no padding, no fill and no
         underline at rest, so a sentence that holds one still reads as a sentence. Hover and pressed take
         accent.primary.hover and the underline, never a fill; disabled is text.disabled. 28 high alone,
         the hit-target floor. Any content works: a string is drawn by the presenter's TextBlock, which takes
         the underline from the style below. The focus ring hugs the words, since there is no padding. -->
    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.accent.primary.hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.accent.primary.hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The Save bar: a raised strip pinned under the page, outlined above, so it reads as the page's own
         and not as a toast. No shadow: the frame and the pill are the only things that float. -->
    <!-- The Save bar (review finding B-46): 16 at the sides and 8 above and below, at least 48 high. -->
    <Style x:Key="SaveBar" TargetType="Border">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.save-bar-height}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.card}" />
    </Style>

    <!-- A pill ToggleButton (the filmstrip's blur toggle). Its own style: one based on a Button style threw
         the first time the shell hosted the pane (2026-09-25). The checked look is the caller's, because
         what "on" means is theirs. -->
    <Style x:Key="Pill.Toggle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="MinWidth" Value="{DynamicResource Layout.hud-control}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.control}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Pill}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- v0.6.0 (Outbox): the pill is part of the frame (Spec §5 S2). Its controls sit on shell.bg, so they
         take the frame's tokens: shell.text for the icon and words, shell.hover under the pointer, and a
         focus ring in shell.accent, which is 4.5:1 or more on shell.bg and shell.hover in both themes
         (§2.1). The ring is 3 px rather than the panes' 2, drawn 4 px outside the control so it never
         touches the glyph, because a pill floating over a customer's desktop has the busiest background
         in the product. High contrast maps all three to system colours through its dictionary. -->
    <Style x:Key="FocusRing.Frame">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4"
                            BorderBrush="{DynamicResource Brush.shell.accent}"
                            BorderThickness="3"
                            CornerRadius="{DynamicResource Radius.pill}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A round 32 px icon button on the pill: Mark, Pause, Stop and the chevron. Named and tool-tipped by
         the caller (name and hotkey, "Pause · Ctrl+Alt+P"). No outline in any state (review finding C-H8,
         design system 10.10): rings appearing round a circle on hover is the default-template look, and Iris
         on press broke the brand's one job. Hover fills shell.hover, pressed shell.pressed, keyboard focus
         draws FocusRing.Frame outside, disabled dims the glyph. The glyph rests in shell.muted and turns
         shell.text under the pointer (C-H7), so the state word is the only full-strength mark at rest. -->
    <Style x:Key="Hud.IconButton" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource Layout.hud-control}" />
        <Setter Property="Height" Value="{DynamicResource Layout.hud-control}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
        <Setter Property="Background" Value="{DynamicResource Brush.shell.bg}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Frame}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.Placement" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.pill}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.shell.hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.shell.pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Table: 36 px rows, a quiet header, a tint on hover and on the selected row. The tint, the accent
         mark at the row's leading edge and the keyboard focus outline are the row's, not its cells', so each
         runs the whole width of the table whatever the columns add up to (v0.6.6). High contrast selects
         the system way, highlight on highlight text, because its tint is the window colour; the mark stays
         where the fill is not drawn. -->
    <!-- A table's row, keyed so a table can name its rows for a screen reader on top of it (ST-084).
         Keyboard focus in a DataGrid sits on a cell. With whole rows selected the row is what is acted on,
         so the outline is drawn round the row (RowFocus says when focus is in it and came by keyboard):
         2 px accent.primary, inside the row's edge, because a ring outside it is cut off by the table's
         edge and by the rows above and below. BorderBrush is the outline's colour and nothing else. -->
    <Style x:Key="Table.Row" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="controls:RowFocus.Track" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Grid>
                        <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter Grid.Column="1"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <DataGridDetailsPresenter Grid.Row="1"
                                                          Grid.Column="1"
                                                          SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                          Visibility="{TemplateBinding DetailsVisibility}" />
                                <DataGridRowHeader Grid.RowSpan="2"
                                                   SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                                   Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            </SelectiveScrollingGrid>
                        </Border>
                        <Rectangle x:Name="Indicator" Style="{StaticResource SelectionBar}" />
                        <Border x:Name="Edge" Style="{StaticResource SelectionEdge}" />
                        <!-- Over the cells, the grid line along the row's bottom edge included. Inside the selection
                             edge by its width (0, or 2 in high contrast), where both are Highlight: drawn on the
                             edge, focus on a selected row changed nothing on screen. -->
                        <Rectangle x:Name="FocusOutline"
                                   Margin="{DynamicResource Thickness.selected-edge}"
                                   RadiusX="4"
                                   RadiusY="4"
                                   SnapsToDevicePixels="True"
                                   Stroke="{TemplateBinding BorderBrush}"
                                   StrokeThickness="{DynamicResource Focus.width}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="controls:RowFocus.Shown" Value="True">
                            <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.hover}" />
            </Trigger>
            <!-- After hover, so a selected row under the pointer stays the selection's tint. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.bg.selected}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Table" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeight" Value="{DynamicResource Layout.row-height}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
                    <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
                    <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="Height" Value="{DynamicResource Layout.row-height}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                    <!-- Spec §3 makes the table sortable, and a header is how it sorts. WPF's headers take no
                         focus, so sorting needed the mouse (ST-084); focusable, Space or Enter sorts. -->
                    <Setter Property="Focusable" Value="True" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter VerticalAlignment="Center">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- The filler WPF adds after the last column is no column and sorts nothing. -->
                        <DataTrigger Binding="{Binding Column, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <!-- The ring is cut off at the table's top edge, so the focused header is drawn in
                             the accent with its words in the accent's text colour, as high contrast draws a
                             selection: an underline alone was too faint on a scaled screen (ST-084). -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.on-accent}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle" Value="{StaticResource Table.Row}" />
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                    <!-- The row draws the keyboard focus outline (Table.Row); a ring round one cell said the
                         cell was the thing acted on, and was cut off at the table's edge. -->
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Split pane: resizable; a 1 px rule in a grip as wide as Spec §7's smallest target, so it is easy to
         catch and quiet to look at. The grip is the gap between two panes, never over them (ST-084). -->
    <Style x:Key="SplitPane.Splitter" TargetType="GridSplitter">
        <Setter Property="Width" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Rectangle x:Name="Rule" Width="1" HorizontalAlignment="Center" Fill="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Rule" Property="Width" Value="2" />
                            <Setter TargetName="Rule" Property="Fill" Value="{DynamicResource Brush.accent.primary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Rule" Property="Width" Value="2" />
                            <Setter TargetName="Rule" Property="Fill" Value="{DynamicResource Brush.accent.primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filmstrip: 160×90 thumbnails with their label underneath; selected = accent outline and tint,
         excluded = dimmed image plus the word (the item template's). The container is sized by its content:
         a fixed 160×90 container cut the label off, so "excluded" was shown by opacity alone. -->
    <Style x:Key="Filmstrip" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <!-- The strip's items are StripItems; a screen reader says SpokenName (ST-084). -->
                    <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}" />
                    <Setter Property="Margin" Value="0,0,8,8" />
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Frame"
                                        MinWidth="176"
                                        MinHeight="106"
                                        Padding="{TemplateBinding Padding}"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="2"
                                        CornerRadius="{DynamicResource Radius.card}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.bg.hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.bg.selected}" />
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                                    </Trigger>
                                    <!-- Keyboard focus outlines the frame in the accent (ST-084): the focus ring is
                                         drawn in the list's scrolling layer and is cut off at its edges. -->
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.accent.primary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Timeline scrubber (collapsed height 40; ST-076 draws the markers) -->
    <Style x:Key="Timeline" TargetType="Border">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.card}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- v0.6.4 (Outbox): the workspace frame and the inbox rail (Spec §5 S3, S4). They sit on
         shell.bg, so they take the frame's tokens: shell.text and shell.muted for words, shell.hover under
         the pointer, and keyboard focus as a 3 px shell.accent ring outside the control, which is 4.5:1 or
         more on shell.bg and shell.hover in both themes where the panes' 2 px accent.primary is 2.80:1 on
         the light frame (§2.1). The open session's row is the session pane's tab: it takes the pane's
         bg.base and content tokens, the 4 px brand.ribbon.band over it, and a 1 px shell.accent edge, which
         is the Highlight outline that stays in high contrast, where the band is the window colour. -->
    <Style x:Key="FocusRing.Rail">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4"
                            BorderBrush="{DynamicResource Brush.shell.accent}"
                            BorderThickness="3"
                            CornerRadius="8"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Text.Frame" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
    </Style>
    <Style x:Key="Text.FrameMuted" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
    </Style>

    <!-- The capture state on the frame (Spec §3, status chip; design system 2.3, review finding A-03): a 28 px
         pill, 12 at the sides, a border.strong edge in every state, Body words in shell.text. Its own
         template, with no panel round the content, so the words can trim to the rail's width. -->
    <Style x:Key="Rail.StatusChip" TargetType="ContentControl">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height-compact}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Background" Value="{DynamicResource Brush.shell.bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.border.strong}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{DynamicResource Thickness.border}"
                            CornerRadius="{DynamicResource Radius.pill}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The rail's search (design system 10.2, review finding A-04): a field on the frame, lighter than its
         ground as Windows 11 draws a field, never a grey well: bg.surface, its edge in shell.muted (3:1 and
         more on shell.bg), text.muted under the pointer. The 16 px glyph sits 12 in, the text and the hint
         at 36. -->
    <Style x:Key="Rail.Search" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="{DynamicResource Padding.search}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.shell.accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.bg.surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.shell.muted}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Thickness.border}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.input}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- Focus as the panes' fields show it (review finding B-09): a 2 px edge over the 1 px one, in
                         the frame's accent, so the query does not shift as the caret arrives. -->
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.control}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="FocusEdge"
                                BorderBrush="{DynamicResource Brush.shell.accent}"
                                BorderThickness="{DynamicResource Thickness.focus}"
                                CornerRadius="{DynamicResource Radius.control}"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.text.muted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusEdge" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A group's list: no chrome and no scroller of its own, since the rail scrolls as a whole. Not a
         stop itself: Tab lands on its open row, or its first, and the arrows move from there. -->
    <Style x:Key="Rail.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A rail row. On the frame at rest; under the pointer shell.hover. The open session's row takes the one
         selection (design system 10.4, review finding A-01): bg.surface with a 1 px border.subtle edge,
         radius 6 on every corner, and the selection bar. It was a tab joined to the pane, with an Iris
         outline and a 4 px band across its top. -->
    <Style x:Key="Rail.Row" TargetType="ListBoxItem">
        <!-- 8 in from both of the rail's edges and 2 apart, 12,8 inside (design system 10.4, review finding A-05). -->
        <Setter Property="Margin" Value="8,0,8,2" />
        <Setter Property="Padding" Value="{DynamicResource Padding.rail-row}" />
        <Setter Property="theme:Pressed.Track" Value="True" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- Both set here, so the theme's own item style never binds them to an ancestor list that a row
             being taken out of the rail no longer has. -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Rail}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
        <Setter Property="IsSelected" Value="{Binding IsOpen, Mode=OneWay}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="{DynamicResource Thickness.border}"
                                CornerRadius="{DynamicResource Radius.control}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Rectangle x:Name="Indicator" Style="{StaticResource SelectionBar}" />
                        <Border x:Name="Edge" Style="{StaticResource SelectionEdge}" CornerRadius="{DynamicResource Radius.control}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.shell.hover}" />
                        </Trigger>
                        <Trigger Property="theme:Pressed.IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.shell.pressed}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.surface}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.border.subtle}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row's words: shell.text and shell.muted on the frame, text.primary and text.secondary on the open row's bg.surface. -->
    <Style x:Key="Rail.RowTitle" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- The note's title under a company: the row's body words, regular weight, one line. -->
    <Style x:Key="Rail.RowSubtitle" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- A row's age: the meta line's look in tabular figures, never trimmed (review finding A-34). -->
    <Style x:Key="Rail.RowAge" BasedOn="{StaticResource Text.Numeric}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Rail.RowMeta" BasedOn="{StaticResource Text.Body}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.text.secondary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!-- A rail group's heading (design system 10.4, review finding A-06): a 28 px row with a row's geometry,
         8 in from the rail's edges, a 1 px clear edge and 12 inside, so its label starts at the same x as
         every row's title (8 + 1 + 12). The label in the Label style in shell.muted, then the count in
         Caption; for a group that opens and closes, the 12 px chevron after the count, so no label is pushed
         right by it. -->
    <Style x:Key="Rail.GroupHeader" TargetType="Border">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height-compact}" />
        <Setter Property="Margin" Value="8,0,8,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource Thickness.border}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.control}" />
    </Style>
    <Style x:Key="Rail.GroupLabel" BasedOn="{StaticResource Text.Label}" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
    </Style>
    <Style x:Key="Rail.GroupCount" BasedOn="{StaticResource Text.FrameMuted}" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
    </Style>

    <!-- A group's heading that opens and closes it (Earlier): the header's geometry, shell.hover under the pointer. -->
    <Style x:Key="Rail.GroupToggle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.control-height-compact}" />
        <Setter Property="Margin" Value="8,0,8,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Rail}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="{DynamicResource Thickness.border}"
                            CornerRadius="{DynamicResource Radius.control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.shell.hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The rail's foot: All sessions, Settings, Diagnostics. Tag="Selected" marks the view the pane shows
         with the one selection on the frame (design system 10.4, review finding A-01): bg.surface, the
         selection bar and Body strong in text.primary, so it is shape and not colour alone, and no longer
         the same grey as hover. -->
    <Style x:Key="Rail.FootItem" TargetType="Button">
        <!-- A nav row (design system 10.4, review finding A-07): 32 high from its own token, not the table's
             row height, so the foot does not grow when rows do. -->
        <Setter Property="MinHeight" Value="{DynamicResource Layout.nav-row-height}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.md}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Rail}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.control}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Rectangle x:Name="Indicator" Style="{StaticResource SelectionBar}" />
                        <Border x:Name="Edge" Style="{StaticResource SelectionEdge}" CornerRadius="{DynamicResource Radius.control}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Edge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.bg.surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                            <Setter Property="FontWeight" Value="{DynamicResource Weight.semibold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.shell.hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.shell.pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.shell.muted}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A link on the frame (the rail's Clear search): shell.accent, underlined under the pointer. -->
    <Style x:Key="Rail.Link" TargetType="Button">
        <Setter Property="MinHeight" Value="{DynamicResource Layout.hit-target-min}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.shell.accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Rail}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.control}">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.shell.hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- v0.6.7 (Spec §2.0): the horizontal lockup on the frame, drawn from
         shared/design/brand/lockup-horizontal-on-navy.svg on its own 348.7 by 96 grid, clear space
         included, so it scales with the box it is given and is sharp at any DPI. The file's colours are the
         tokens' (§2.0: nothing in the app uses a brand hex): the ribbon brand.signature, its underside and
         the long note line shell.text (paper), the dots and the short line shell.accent (Ribbon 400), the
         wordmark shell.text, all on shell.bg. The file knocks the screen's surround out of the ribbon with
         a mask; here a shell.bg plate is drawn over the ribbon instead, which is the same picture on a flat
         frame, and the screen is the frame's own colour. In high contrast the ribbon and the word are the
         window text, the screen is knocked out, and the dots take the highlight colour. Decoration: the window's
         title and the step's heading name the app, so it has no automation peer and takes no focus. -->
    <ControlTemplate x:Key="Brand.Lockup.Frame" TargetType="Control">
        <Viewbox Stretch="Uniform">
            <Canvas Width="348.7" Height="96">
                <Canvas Canvas.Left="16" Canvas.Top="16">
                    <Path Data="M60,4 L54,16 H21 A5,5 0 0 0 21,26 H32 V38 H21 A17,17 0 0 1 21,4 Z" Fill="{DynamicResource Brush.brand.signature}" />
                    <Path Clip="M16.17,19.71 L-10.04,29.05 L-8,64 L44,64 L44,19.71 Z" Data="M60,4 L54,16 H21 A5,5 0 0 0 21,26 H32 V38 H21 A17,17 0 0 1 21,4 Z" Fill="{DynamicResource Brush.shell.text}" />
                    <Canvas>
                        <Canvas.RenderTransform>
                            <RotateTransform Angle="180" CenterX="32" CenterY="32" />
                        </Canvas.RenderTransform>
                        <Path Data="M60,4 L54,16 H21 A5,5 0 0 0 21,26 H32 V38 H21 A17,17 0 0 1 21,4 Z" Fill="{DynamicResource Brush.brand.signature}" />
                        <Path Clip="M16.17,19.71 L-10.04,29.05 L-8,64 L44,64 L44,19.71 Z" Data="M60,4 L54,16 H21 A5,5 0 0 0 21,26 H32 V38 H21 A17,17 0 0 1 21,4 Z" Fill="{DynamicResource Brush.shell.text}" />
                    </Canvas>
                    <Path Fill="{DynamicResource Brush.shell.bg}">
                        <Path.Data>
                            <RectangleGeometry Rect="13,17,38,30" RadiusX="7" RadiusY="7" />
                        </Path.Data>
                    </Path>
                    <Path Fill="{DynamicResource Brush.shell.accent}">
                        <Path.Data>
                            <GeometryGroup FillRule="Nonzero">
                                <EllipseGeometry Center="21,25.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="25.5,25.5" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="30,25.5" RadiusX="1.5" RadiusY="1.5" />
                                <RectangleGeometry Rect="20,36,14,3" RadiusX="1.5" RadiusY="1.5" />
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                    <Path Fill="{DynamicResource Brush.shell.text}">
                        <Path.Data>
                            <RectangleGeometry Rect="20,30,22,3" RadiusX="1.5" RadiusY="1.5" />
                        </Path.Data>
                    </Path>
                </Canvas>
                <!-- "ScreenTrail" in Exo 2 ExtraBold, as outlines (SIL Open Font License 1.1): no font to install.
                     F1 is the SVG's nonzero fill: WPF's path data fills even-odd unless told, and the glyphs'
                     overlapping contours then cut holes in the "e", "T" and "a" (seen in the 150% render). -->
