                <Path Data="F1 M254.88 32.99V63.01H246.72V32.99ZM263.57 32.99V39.21H238.03V32.99ZM271.64 41.39 272.62 45.73 273.38 46.29V63.01H265.47V41.39ZM282.17 40.8 281.47 48.04H279.41Q278.08 48.04 276.52 48.3Q274.97 48.56 272.55 49.18L272.07 44.85Q274.25 42.84 276.54 41.82Q278.83 40.8 280.98 40.8ZM295.77 40.8Q298.69 40.8 300.69 41.56Q302.69 42.33 303.73 44.16Q304.78 45.99 304.78 49.2V63.01H298.5L297.4 58.36L296.87 57.58V49.16Q296.83 47.85 296.21 47.25Q295.59 46.65 293.91 46.65Q292.22 46.65 289.75 46.73Q287.28 46.8 284.58 46.95L283.86 41.85Q285.47 41.56 287.64 41.33Q289.81 41.09 291.97 40.94Q294.13 40.8 295.77 40.8ZM301.66 49.72 301.62 53.75 292.36 53.76Q291.37 53.77 290.91 54.23Q290.46 54.69 290.46 55.46V56.31Q290.46 57.12 290.99 57.59Q291.52 58.07 292.62 58.07Q293.7 58.07 294.93 57.58Q296.15 57.09 297.31 56.27Q298.48 55.44 299.34 54.47V57.24Q299 57.95 298.29 59.01Q297.59 60.07 296.45 61.12Q295.31 62.16 293.71 62.87Q292.11 63.57 289.96 63.57Q287.99 63.57 286.34 62.88Q284.68 62.19 283.71 60.82Q282.74 59.46 282.74 57.45V55.24Q282.74 52.66 284.58 51.19Q286.43 49.72 289.62 49.72ZM316.18 41.39V63.01H308.32V41.39ZM313.94 31.64Q316.25 31.64 316.25 33.98V36.26Q316.25 38.6 313.94 38.6H310.55Q308.25 38.6 308.25 36.26V33.98Q308.25 31.64 310.55 31.64ZM327.84 32.56V55.56Q327.84 56.52 328.43 56.97Q329.02 57.42 330.18 57.42H331.79L332.66 62.56Q332.07 62.91 330.98 63.12Q329.89 63.34 328.76 63.45Q327.63 63.57 326.84 63.57Q323.65 63.57 321.81 62.01Q319.98 60.45 319.98 57.63V32.56Z" Fill="{DynamicResource Brush.shell.text}" />
