<UserControl x:Class="ScreenTrail.UI.History.InboxRailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
             xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
             xmlns:core="clr-namespace:ScreenTrail.Core.History;assembly=ScreenTrail.Core">
    <!-- Spec v0.6.0 §5 S4, as built v0.6.4: the inbox rail. Search, then the groups in order with their
         counts, each a list a screen reader hears by its name and count. Its foot (All sessions, Settings,
         Diagnostics) is the shell's, below this view. -->
    <UserControl.Resources>
        <!-- One row (spec v0.6.9 S4): the company, else the note's title, else the tool, and how long ago on
             the first line; the note's title under a company; then ticket, tool and duration (or, for a row
             headed by the tool, duration and screenshots) with a state badge where the group does not
             already say it. A line with nothing to say is not drawn. Long words end in an ellipsis and the
             tool tip has them whole. -->
        <DataTemplate x:Key="Rail.RowTemplate">
            <Grid ToolTip="{Binding Full}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Rail.RowTitle}" Text="{Binding Title}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Rail.RowMeta}" Text="{Binding Age}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Margin="0,4,0,0"
                           Style="{StaticResource Rail.RowSubtitle}"
                           Visibility="{Binding SubtitleVisibility}"
                           Text="{Binding Subtitle}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,0,0" VerticalAlignment="Center" Style="{StaticResource Rail.RowMeta}" Text="{Binding Meta}" />
                <ContentControl Grid.Row="2"
                                Grid.Column="1"
                                Margin="8,4,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Badge}"
                                theme:Badge.Tone="{Binding BadgeTone}"
                                theme:Badge.Glyph="{Binding BadgeGlyph}"
                                Visibility="{Binding BadgeVisibility}">
                    <TextBlock Text="{Binding Badge}" />
                </ContentControl>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search over what the rows say (Ctrl+F). The hint sits behind the text and goes once anything is typed. -->
        <Grid Grid.Row="0" Margin="16,16,16,8">
            <controls:Glyph Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            Panel.ZIndex="1"
                            IsHitTestVisible="False"
                            Style="{StaticResource Icon}"
                            Foreground="{DynamicResource Brush.shell.muted}"
                            Text="{StaticResource Icon.Search}" />
            <!-- At 36, where the typed text starts (32 and 4 inside). -->
            <TextBlock Margin="32,0,12,0"
                       Padding="4,0,0,0"
                       VerticalAlignment="Center"
                       Panel.ZIndex="1"
                       IsHitTestVisible="False"
                       Style="{StaticResource Text.FrameMuted}"
                       FontSize="{DynamicResource Size.md}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Visibility="{Binding SearchHintVisibility}"
                       Text="{x:Static core:InboxRail.SearchHint}" />
            <TextBox x:Name="Search"
                     Style="{StaticResource Rail.Search}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search sessions"
                     AutomationProperties.HelpText="{x:Static core:InboxRail.SearchHelp}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Focusable="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,8">
                <!-- Nothing to list: asking, not answered, no sessions yet, or nothing matches the search. -->
                <!-- The rail's empty state (review finding A-08): the empty state's parts at 40 and 20, left
                     aligned with the rows' words, 24 below the search; the sentence in body text, not fine print. -->
                <!-- In line with the rows' words: the rail's 8 inset, then the row's 12. -->
                <Border Margin="8,24,16,8" Padding="12,0,0,0" Visibility="{Binding NoticeVisibility}">
                <StackPanel>
                    <!-- The first load (design system 10.8): three two-line rows of skeleton, the lines at 60, 80
                         and 40% in turn, in place of the disc while the rail asks the service for the first time.
                         The sentence stays under them, so the wait is said as well as drawn. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notice}" Value="{x:Static core:InboxRail.Asking}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Skeleton.Frame}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Skeleton.Frame}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Skeleton.Frame}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Skeleton.Frame}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Skeleton.Frame}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Skeleton.Frame}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <Border>
                        <Border.Style>
                            <Style BasedOn="{StaticResource EmptyState.Disc.Rail}" TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notice}" Value="{x:Static core:InboxRail.Asking}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:Glyph>
                            <controls:Glyph.Style>
                                <Style BasedOn="{StaticResource EmptyState.Icon.Rail}" TargetType="controls:Glyph">
                                    <Setter Property="Text" Value="{StaticResource Icon.History}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClearSearchVisibility}" Value="Visible">
                                            <Setter Property="Text" Value="{StaticResource Icon.Search}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:Glyph.Style>
                        </controls:Glyph>
                    </Border>
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap"
                               Text="{Binding Notice}"
                               controls:LiveRegion.Setting="Polite" />
                    <Button Margin="0,8,0,0"
                            Style="{StaticResource Rail.Link}"
                            Content="Clear search"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding ClearSearchVisibility}" />
                </StackPanel>
                </Border>

                <controls:Repeater ItemsSource="{Binding Groups}">
                    <controls:Repeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding Visibility}">
                                <!-- The heading: words and the count, or for Earlier a toggle that opens it, the chevron after the
                                     count. Muted, so it reads as a label over the rows and not as one more row; groups sit 16 apart,
                                     rows 2. Every label starts where the rows' titles do (Rail.GroupHeader). -->
                                <Border Style="{StaticResource Rail.GroupHeader}" Visibility="{Binding HeaderTextVisibility}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Rail.GroupLabel}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Rail.GroupCount}" Text="{Binding CountText}" />
                                    </StackPanel>
                                </Border>
                                <ToggleButton Style="{StaticResource Rail.GroupToggle}"
                                              IsChecked="{Binding IsExpanded}"
                                              Visibility="{Binding ToggleVisibility}"
                                              AutomationProperties.Name="{Binding Heading}"
                                              AutomationProperties.HelpText="Shows or hides the older sessions.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Rail.GroupLabel}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Rail.GroupCount}" Text="{Binding CountText}" />
                                        <controls:Glyph Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource Icon}"
                                                        FontSize="{DynamicResource Icon.sm}"
                                                        Foreground="{DynamicResource Brush.shell.muted}"
                                                        Text="{Binding Chevron}" />
                                    </StackPanel>
                                </ToggleButton>
                                <ListBox Style="{StaticResource Rail.List}"
                                         ItemsSource="{Binding Rows}"
                                         ItemContainerStyle="{StaticResource Rail.Row}"
                                         ItemTemplate="{StaticResource Rail.RowTemplate}"
                                         Visibility="{Binding RowsVisibility}"
                                         SelectionChanged="OnSelectionChanged"
                                         PreviewKeyDown="OnRowKeyDown"
                                         AutomationProperties.Name="{Binding Heading}" />
                            </StackPanel>
                        </DataTemplate>
                    </controls:Repeater.ItemTemplate>
                </controls:Repeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
