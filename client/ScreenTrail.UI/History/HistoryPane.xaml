<UserControl x:Class="ScreenTrail.UI.History.HistoryPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
             xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
             xmlns:local="clr-namespace:ScreenTrail.UI.History"
             xmlns:core="clr-namespace:ScreenTrail.Core.History;assembly=ScreenTrail.Core"
             AutomationProperties.Name="All sessions">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- What the last discard did, unless it did not happen: then the reason is shown in its place. -->
        <Style x:Key="History.Notice" BasedOn="{StaticResource Text.Secondary}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DiscardFailed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The table when there are rows, the sentence as an empty state when there are none. -->
        <Style x:Key="History.Table" BasedOn="{StaticResource Table}" TargetType="DataGrid">
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The table's card, gone with the table when there are no rows; the table's own edge is the card's. -->
        <Style x:Key="History.TableCard" BasedOn="{StaticResource Card}" TargetType="Border">
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The count beside the title is a Caption in text.muted (review finding A-15): the title is the
             screen's name, the count a fact about it. -->
        <Style x:Key="History.Count" BasedOn="{StaticResource Text.Caption}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="History.Empty" BasedOn="{StaticResource EmptyState}" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The actions only when there is a session to act on: with none, the empty state's sentence
             is the whole screen, not beside an Open with nothing to open. -->
        <Style x:Key="History.Actions" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A cell's words end in an ellipsis, not under the next column, when a column is too narrow for them. -->
        <!-- A cell trims to one line; the whole text is in its tooltip, so a trimmed value can still be read
             (review finding E-27). -->
        <Style x:Key="History.CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <!-- A number column: right aligned and tabular, so the figures line up (design system 3.2, E-08). -->
        <Style x:Key="History.CellNumber" BasedOn="{StaticResource History.CellText}" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Typography.NumeralStyle" Value="Lining" />
        </Style>
        <!-- A number column's header sits over its figures, on the right (review finding A-10). -->
        <Style x:Key="History.NumberHeader" BasedOn="{StaticResource Table.Header}" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>
    <!-- Spec §5 S4, as built v0.6.6: the table takes the pane's width, and its Session column (Status until
         v0.7.19) takes what the others leave, so the rows and the selection run from edge to edge. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header: the title, and the count beside it. Since v0.6.4 the rail is History; this table,
             opened from the rail's foot, is where several sessions are selected at once. -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="All sessions" />
                <!-- 8 from the title, both at the bottom of the row, so the Caption sits on the title's line
                     rather than nudged up off it. -->
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Bottom"
                           Style="{StaticResource History.Count}"
                           Text="{Binding Status}"
                           controls:LiveRegion.Setting="Polite" />
            </StackPanel>

            <!-- Spec v0.6.9 S4: the v0.5 filters (status, tool, and the date range as whole-day periods),
                 above the table they filter, once there is a session. They wrap rather than clip in a
                 narrow pane. Each list says what it filters by in its first entry ("Any status"). -->
            <WrapPanel Margin="0,16,0,0" Orientation="Horizontal" Visibility="{Binding FiltersVisibility}">
                <ComboBox Width="{DynamicResource Layout.field-narrow}"
                          Margin="0,0,8,8"
                          ItemsSource="{x:Static core:HistoryFilters.StatusChoices}"
                          SelectedItem="{Binding StatusChoice}"
                          AutomationProperties.Name="Filter by status" />
                <ComboBox Width="{DynamicResource Layout.field-narrow}"
                          Margin="0,0,8,8"
                          ItemsSource="{Binding ToolChoices}"
                          SelectedItem="{Binding ToolChoice}"
                          AutomationProperties.Name="Filter by tool" />
                <ComboBox Width="{DynamicResource Layout.field-narrow}"
                          Margin="0,0,8,8"
                          ItemsSource="{x:Static core:HistoryFilters.PeriodChoices}"
                          SelectedItem="{Binding PeriodChoice}"
                          AutomationProperties.Name="Filter by when the session started" />
                <Button Margin="0,0,0,8"
                        Style="{StaticResource Button.Link}"
                        Content="Clear filters"
                        Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding ClearFiltersVisibility}" />
            </WrapPanel>

            <!-- Spec v0.7.3 S4: the coverage banner, under the filters, describing the rows they leave
                 (ST-079). The line, then why the misses were missed. The info banner, not a new control;
                 hidden when there is nothing honest to say (no counts, a status filter, nothing seen). -->
            <ContentControl Margin="0,8,0,0"
                    Style="{StaticResource Banner}"
                    Visibility="{Binding CoverageVisibility}"
                    ToolTip="{Binding CoverageHelp}"
                    AutomationProperties.Name="{Binding CoverageSpoken}"
                    AutomationProperties.HelpText="{Binding CoverageHelp}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap"
                               Text="{Binding CoverageHeadline}"
                               AutomationProperties.Name="{Binding CoverageSpoken}"
                               AutomationProperties.HelpText="{Binding CoverageHelp}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="{Binding CoverageDetail}"
                               Visibility="{Binding CoverageDetailVisibility}" />
                </StackPanel>
            </ContentControl>
        </StackPanel>

        <!-- Review finding A-09: the table in a card (radius 8, its rows clipped to the corners), ending under
             its last row instead of a framed white box the pane's height, with the actions 16 under it. The
             card and the actions are one top-aligned grid: the card's row takes what the actions leave, so a
             long list scrolls inside the card and the actions stay on screen. -->
        <Grid x:Name="TableAndActions" Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="TableCard"
                    Grid.Row="0"
                    Style="{StaticResource History.TableCard}"
                    theme:RoundedClip.Inside="True">
                <!-- Extended: click, Shift and Ctrl with the mouse, Shift and Ctrl with the arrows and Space, and
                     Ctrl+A, the way every Windows table selects. Spec §5 S4: multi-select, then Bulk discard. -->
                <DataGrid x:Name="Sessions"
                          Style="{StaticResource History.Table}"
                          ItemsSource="{Binding Rows}"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          SelectionChanged="OnSelectionChanged"
                          MouseDoubleClick="OnOpen"
                          PreviewKeyDown="OnTableKeyDown"
                          AutomationProperties.Name="Sessions"
                          AutomationProperties.HelpText="Enter opens the session. Select one or more sessions with Shift or Ctrl, then choose Discard selected.">
                    <!-- The table's row style with each row named for a screen reader (ST-084). -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource Table.Row}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Review findings R-03 and A-10: Started, then which session it is, taking what the others
                             leave (it was Status, about 430 px of nothing beside a badge), then Status as wide as its
                             badges and the two numbers at the end, right aligned under right-aligned headers. The tool
                             ends the Session line ("Acme Dental · Printer offline · #48213 · ScreenConnect"): with a
                             column of its own nothing fitted the smallest window. At their least the columns add up to 660, which with the card's edge the pane holds at the window's 960 minimum beside a scroll bar. -->
                        <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="152" ElementStyle="{StaticResource History.CellText}" />
                        <DataGridTextColumn x:Name="SessionColumn" Header="Session" Binding="{Binding Session}" Width="*" MinWidth="132" ElementStyle="{StaticResource History.CellText}" />
                        <!-- The status as a badge in the rail's word, glyph and hue (spec v0.6.9 S4), so a state reads
                             the same on both and never by colour alone. -->
                        <!-- "Not confirmed" sits beside the status, never in place of it: a publish of the session may
                             have reached the ticket, and the session is still a draft or published in part. Not
                             focusable, so it is no tab stop; the row's own name says it to a screen reader. -->
                        <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="168" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource Badge}" theme:Badge.Tone="{Binding StatusTone}" theme:Badge.Glyph="{Binding StatusGlyph}">
                                            <TextBlock Text="{Binding Status}" />
                                        </ContentControl>
                                        <ContentControl Margin="8,0,0,0"
                                                        Style="{StaticResource Badge}"
                                                        theme:Badge.Tone="Warning"
                                                        theme:Badge.Glyph="{x:Static local:HistoryRow.NotConfirmedGlyph}"
                                                        Visibility="{Binding NotConfirmedVisibility}"
                                                        ToolTip="A publish of this session may have reached the ticket. Check the ticket, then publish again from Review or mark it as published."
                                                        AutomationProperties.Name="Publish not confirmed">
                                            <TextBlock Text="{Binding NotConfirmedLabel}" />
                                        </ContentControl>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="DurationColumn" Header="Duration" Binding="{Binding Duration}" Width="96" HeaderStyle="{StaticResource History.NumberHeader}" ElementStyle="{StaticResource History.CellNumber}" />
                        <DataGridTemplateColumn x:Name="ScreenshotsColumn" Header="Screenshots" Width="112" HeaderStyle="{StaticResource History.NumberHeader}" SortMemberPath="Frames">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource History.CellNumber}" Text="{Binding Frames}" />
                                        <TextBlock Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.Caption}"
                                                   Text="{Binding LeftOut}"
                                                   Visibility="{Binding HasLeftOut, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid x:Name="Actions" Grid.Row="1" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource History.Actions}">
                    <Button Style="{StaticResource Button.Primary}"
                            Content="Open"
                            Command="{Binding OpenCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=Sessions}" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Text="Or press Enter, or double-click a session." />
                </StackPanel>

                <!-- How many are selected and how many of those a discard would take, so the number the
                     dialog asks for is never a surprise. Then the button, on the right, apart from Open. -->
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Margin="16,0,12,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Secondary}"
                           Text="{Binding SelectionNote}"
                           controls:LiveRegion.Setting="Polite" />
                <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource History.Actions}">
                    <!-- For one selected session whose publish was not confirmed: the technician checked the
                         ticket and the note is there. Asks first, sends nothing to the ticket. -->
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource Button.Secondary}"
                            Content="Mark as published"
                            Command="{Binding MarkPublishedCommand}"
                            ToolTip="For one session marked Not confirmed: after checking the ticket, record that the earlier publish is there. Nothing is sent again."
                            AutomationProperties.Name="Mark as published: the selected session"
                            AutomationProperties.HelpText="For one selected session marked Not confirmed. After you have checked the ticket, records that the earlier publish is there. Nothing is sent again. You will be asked to confirm." />
                    <Button Style="{StaticResource Button.Danger}"
                            Content="Discard selected"
                            Command="{Binding BulkDiscardCommand}"
                            ToolTip="Discard the selected sessions. You will be asked to type how many."
                            AutomationProperties.Name="Discard selected sessions"
                            AutomationProperties.HelpText="Deletes the selected sessions' screenshots, transcripts and notes from this PC. You will be asked to type how many." />
                </StackPanel>

                <!-- What the last discard did, or why it did not happen: beside the button, never a dialog,
                     and read out as it changes. -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Right"
                           Style="{StaticResource Text.Error}"
                           Visibility="{Binding DiscardFailed, Converter={StaticResource Visible}}"
                           Text="{Binding DiscardError}"
                           controls:LiveRegion.Setting="Assertive" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Right"
                           Style="{StaticResource History.Notice}"
                           Text="{Binding Notice}"
                           controls:LiveRegion.Setting="Polite" />
            </Grid>
        </Grid>

        <!-- Nothing yet: the same sentence the count line says, as the screen's content. -->
        <StackPanel Grid.Row="1" Style="{StaticResource History.Empty}">
            <Border Style="{StaticResource EmptyState.Disc}">
                <controls:Glyph Style="{StaticResource EmptyState.Icon}" Text="{StaticResource Icon.History}" />
            </Border>
            <TextBlock Style="{StaticResource EmptyState.Message}" Text="{Binding Status}" controls:LiveRegion.Setting="Polite" />
            <Button Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Button.Link}"
                    Content="Clear filters"
                    Command="{Binding ClearFiltersCommand}"
                    Visibility="{Binding ClearFiltersVisibility}" />
        </StackPanel>

    </Grid>
</UserControl>
