<Window x:Class="ScreenTrail.UI.Diagnostics.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
        xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
        xmlns:shell="clr-namespace:ScreenTrail.Core.Shell;assembly=ScreenTrail.Core"
        Title="Diagnostics"
        Width="{StaticResource Layout.dialog-width}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.bg.surface}"
        theme:TitleBar.Caption="Surface"
        Style="{StaticResource Window.Base}">
    <!-- Spec §5 S1's panel, opened from the tray and from the rail's foot (Diagnostics). As tall as its rows
         (v0.6.11): at the spec's fixed 420 the last rows sat under a scroll bar that nothing in the panel
         could scroll from the keyboard, since nothing in it takes focus. -->
    <!-- Review finding D-12: the panel is its surface, caption and body alike. -->
    <Grid Margin="{DynamicResource Padding.pane}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource Text.SectionHeading}"
                   Text="What's being captured right now?" />

        <!-- The one line a customer standing behind the technician needs to be able to read: the state in
             words, with its glyph and colour (Spec §1.1), and the Local-only badge (Spec §5 S1). With the
             service not answering it is a warning, since nothing below is known. -->
        <!-- The banner's own glyph is off: this line draws the capture state's glyph, which is not a tone's. -->
        <ContentControl Grid.Row="1" Margin="0,12,0,0" theme:Banner.Glyph="">
            <ContentControl.Style>
                <Style BasedOn="{StaticResource Banner}" TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Unknown">
                            <Setter Property="theme:Banner.Tone" Value="Warning" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Capturing: the 8 px recording dot, drawn rather than a "●" in the UI face (review finding
                     B-54), centred on the headline's first line. Paused: two bars. Not capturing: eye-off.
                     Unknown: warning. -->
                <Grid Grid.Column="0" MinWidth="{DynamicResource Icon.control}" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Grid Height="{DynamicResource Leading.body}" VerticalAlignment="Top">
                        <Ellipse x:Name="RecordingMark">
                            <Ellipse.Style>
                                <Style BasedOn="{StaticResource StateDot}" TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Capturing">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <controls:Glyph VerticalAlignment="Top">
                        <controls:Glyph.Style>
                            <Style BasedOn="{StaticResource Icon}" TargetType="controls:Glyph">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Paused">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.state.paused}" />
                                        <Setter Property="Text" Value="{StaticResource Icon.Pause}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="NotCapturing">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.state.scope}" />
                                        <Setter Property="Text" Value="{StaticResource Icon.Hide}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Unknown">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.state.paused}" />
                                        <Setter Property="Text" Value="{StaticResource Icon.Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:Glyph.Style>
                    </controls:Glyph>
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Text.Body}"
                               FontWeight="{DynamicResource Weight.semibold}"
                               Text="{Binding Headline}"
                               AutomationProperties.Name="Capture status"
                               controls:LiveRegion.Setting="Polite" />
                    <ContentControl Margin="0,4,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource Badge}"
                                    Content="Local-only"
                                    Visibility="{Binding LocalOnlyVisibility}"
                                    AutomationProperties.Name="Local-only: nothing leaves this PC but what you publish" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <!-- Review finding B-55: with no answer the rows would say "unknown" twelve times; one line says why
             there is nothing to show, and the rows card is hidden. Empty once the service answers. -->
        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   Style="{StaticResource Text.Caption}"
                   Text="{Binding InPlaceOfRows}" />

        <!-- States only, never content (INV-10). The scroll viewer stays for a window made shorter than its
             rows by a large text setting; at 100% and 150% the panel is as tall as they are. -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Style="{StaticResource Card}"
                Padding="0"
                Visibility="{Binding RowsVisibility}">
            <ScrollViewer Padding="16,8,8,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <controls:Repeater ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Review finding B-54: the value is what is read, so it is Body 14 in text.primary
                                 and the label stays Label; it was the other way round, 12/600 over 12/400.
                                 Counts and percentages are tabular, the policy and client versions mono. -->
                            <Grid Margin="0,4,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Width="{DynamicResource Layout.diagnostics-label-width}"
                                           Margin="0,0,8,0"
                                           Style="{StaticResource Text.Label}"
                                           Text="{Binding Label}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="Value"
                                           Grid.Column="1"
                                           Style="{StaticResource Text.Body}"
                                           Text="{Binding Value}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static shell:DiagnosticsValue.Number}">
                                    <Setter TargetName="Value" Property="Style" Value="{StaticResource Text.Numeric}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static shell:DiagnosticsValue.Identifier}">
                                    <Setter TargetName="Value" Property="Style" Value="{StaticResource Text.Mono}" />
                                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.text.primary}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>
            </ScrollViewer>
        </Border>

        <!-- Said once Copy has run, where the technician is looking, and read out. -->
        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Style="{StaticResource Text.Muted}"
                   Text="{Binding Copied}"
                   controls:LiveRegion.Setting="Polite" />

        <!-- The clipboard text is built from the diagnostics record alone. Close is the panel's one filled
             button, as on the shortcut sheet, and Esc presses it. -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource Button.Secondary}"
                    Content="Copy diagnostics"
                    Command="{Binding CopyCommand}"
                    AutomationProperties.Name="Copy diagnostics to the clipboard" />
            <Button x:Name="CloseButton"
                    Grid.Column="2"
                    Style="{StaticResource Button.Secondary}"
                    Content="Close"
                    IsCancel="True"
                    Click="OnClose"
                    AutomationProperties.Name="Close diagnostics" />
        </Grid>
    </Grid>
</Window>
