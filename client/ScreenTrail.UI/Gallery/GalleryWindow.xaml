<Window x:Class="ScreenTrail.UI.Gallery.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
        xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
        Title="ScreenTrail component gallery"
        Width="1100"
        Height="900"
        Style="{StaticResource Window.Base}">
    <!-- ST-016, rebuilt for review finding B-56: the component reference. A state matrix first, one row per
         control style and one column per state (GalleryCatalogue, built in code), then the tones and the
         feedback pieces. The product's dialogs are not copied here: they have renders of their own. -->
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="16,8"
                Background="{DynamicResource Brush.bg.surface}"
                BorderBrush="{DynamicResource Brush.border.subtle}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.ScreenTitle}" Text="Component gallery" VerticalAlignment="Center" />
                <TextBlock Margin="16,0,8,0" Style="{StaticResource Text.Secondary}" Text="Theme" VerticalAlignment="Center" />
                <Button x:Name="DarkButton" Click="OnTheme" Content="Dark" Style="{StaticResource Button.Secondary}" Tag="Dark" />
                <Button x:Name="LightButton" Margin="8,0,0,0" Click="OnTheme" Content="Light" Style="{StaticResource Button.Secondary}" Tag="Light" />
                <Button x:Name="HighContrastButton" Margin="8,0,0,0" Click="OnTheme" Content="High contrast" Style="{StaticResource Button.Secondary}" Tag="HighContrast" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Sections" Margin="24">
                <StackPanel.Resources>
                    <Style TargetType="StackPanel" x:Key="Row">
                        <Setter Property="Orientation" Value="Horizontal" />
                        <Setter Property="Margin" Value="0,8,0,24" />
                    </Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.SectionHeading}" />
                </StackPanel.Resources>

                <TextBlock Text="States" />
                <Grid x:Name="Matrix" Margin="0,8,0,24" HorizontalAlignment="Left" />

                <TextBlock Text="Badges" />
                <StackPanel x:Name="Badges" Style="{StaticResource Row}" />

                <TextBlock Text="Banners" />
                <StackPanel x:Name="Banners" Width="640" Margin="0,8,0,24" HorizontalAlignment="Left" />

                <TextBlock Text="Feedback" />
                <StackPanel Style="{StaticResource Row}">
                    <ContentControl Style="{StaticResource Toast}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Body}" Text="Deleted frame 2" VerticalAlignment="Center" />
                            <Button Margin="12,0,0,0" Content="Undo" Style="{StaticResource Button.Secondary}" theme:Density.Compact="True" />
                        </StackPanel>
                    </ContentControl>
                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Control Foreground="{DynamicResource Brush.accent.primary}" Style="{StaticResource ProgressRing}" />
                        <TextBlock Margin="8,0,0,0" Style="{StaticResource Text.Secondary}" Text="Checking" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Width="{DynamicResource Layout.field-narrow}" Margin="24,0,0,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource Skeleton}" />
                        <Border Width="96" HorizontalAlignment="Left" Style="{StaticResource Skeleton}" />
                    </StackPanel>
                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Margin="0,0,4,0" Style="{StaticResource KeyCap}">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.KeyHint}" Text="Ctrl" />
                        </Border>
                        <Border Margin="0,0,4,0" Style="{StaticResource KeyCap}">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.KeyHint}" Text="Alt" />
                        </Border>
                        <Border Style="{StaticResource KeyCap}">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.KeyHint}" Text="M" />
                        </Border>
                    </StackPanel>
                    <!-- The tooltip is drawn in a popup a window render never sees, so it is drawn on its own
                         and shown here as a picture of itself (GalleryWindow.DrawToolTip). -->
                    <Image x:Name="ToolTipSample" Margin="24,0,0,0" VerticalAlignment="Center" Stretch="None" />
                    <ScrollBar Height="96" Margin="24,0,0,0" Maximum="100" Orientation="Vertical" ViewportSize="40" Value="20" />
                </StackPanel>

                <TextBlock Text="State dots" />
                <StackPanel Style="{StaticResource Row}">
                    <Ellipse Margin="0,0,8,0" Style="{StaticResource StateDot}" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="Recording" VerticalAlignment="Center" />
                    <Ellipse Margin="16,0,8,0" Fill="{DynamicResource Brush.state.paused}" Style="{StaticResource StateDot}" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="Paused: password field" VerticalAlignment="Center" />
                    <Ellipse Margin="16,0,8,0" Fill="{DynamicResource Brush.state.scope}" Style="{StaticResource StateDot}" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="Not capturing: Outlook" VerticalAlignment="Center" />
                    <Ellipse Margin="16,0,8,0" Fill="{DynamicResource Brush.state.offline}" Style="{StaticResource StateDot}" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="Offline" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Table" />
                <DataGrid x:Name="SampleTable"
                          Height="140"
                          Margin="0,8,0,24"
                          IsReadOnly="True"
                          Style="{StaticResource Table}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Status}" Header="Status" Width="100" />
                        <DataGridTextColumn Binding="{Binding Started}" Header="Started" Width="120" />
                        <DataGridTextColumn Binding="{Binding Duration}" Header="Duration" Width="90" />
                        <DataGridTextColumn Binding="{Binding Tool}" Header="Tool" Width="140" />
                        <DataGridTextColumn Binding="{Binding Client}" Header="Client / ticket" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Split pane and filmstrip" />
                <Grid Height="160" Margin="0,8,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="Note pane" />
                    </Border>
                    <GridSplitter Grid.Column="1" Style="{StaticResource SplitPane.Splitter}" />
                    <ListBox x:Name="Strip" Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource Filmstrip}">
                        <ListBoxItem>
                            <TextBlock Margin="8" Style="{StaticResource Text.Muted}" Text="1 · Services list" />
                        </ListBoxItem>
                        <ListBoxItem IsSelected="True">
                            <TextBlock Margin="8" Style="{StaticResource Text.Muted}" Text="2 · Spooler: Stopped" />
                        </ListBoxItem>
                        <ListBoxItem Opacity="0.45">
                            <TextBlock Margin="8" Style="{StaticResource Text.Muted}" Text="3 · Excluded" />
                        </ListBoxItem>
                    </ListBox>
                </Grid>

                <TextBlock Text="Timeline (collapsed)" />
                <Border Margin="0,8,0,24" Style="{StaticResource Timeline}">
                    <TextBlock Style="{StaticResource Text.Mono}" Text="14:04:40  &quot;clearing the queue now&quot;" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
