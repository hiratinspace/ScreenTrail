<Window x:Class="ScreenTrail.UI.Shell.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
        xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
        Title="{Binding Heading}"
        Width="{StaticResource Layout.dialog-width}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.bg.surface}"
        theme:TitleBar.Caption="Surface"
        Style="{StaticResource Window.Base}">
    <!-- The app's one dialog (Spec §3 Modal, v0.6.11): the question, what follows, the phrase box when
         something irreversible is asked, and two buttons that say what each does. Esc presses the one that
         changes nothing. Where focus starts is set as it loads: in the phrase box when there is one (it
         was opened to type, ST-084), otherwise on Cancel when Enter must not act by reflex. -->
    <!-- Review finding B-50 (design system 10.6): the question on the surface with 24 around it, and the
         buttons on a footer of their own, bg.base under a 1 px border.subtle rule, 24,16, right aligned
         8 apart. It was one grey sheet with the buttons 24 under the words. -->
    <StackPanel x:Name="Sheet">
        <StackPanel x:Name="Body" Background="{DynamicResource Brush.bg.surface}">
        <StackPanel Margin="{DynamicResource Padding.pane}">
        <!-- The question with its kind's glyph beside it, never colour alone (Spec §1.1): a warning in
             state.danger for what destroys something, in state.paused for a notice that something did not
             happen, the info glyph in text.secondary for any other question (no Iris on an icon at rest,
             design system 2.2). Set as it loads. Review finding B-51: the glyph is 20 with 12 after it, and
             everything under the question starts at the question's text, so the glyph hangs. -->
        <Grid x:Name="Question">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:Glyph x:Name="Mark"
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,2,12,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource Icon}"
                            FontSize="{DynamicResource Icon.lg}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.SectionHeading}" Text="{Binding Heading}" />

        <!-- What is actually lost, in the words a technician would use. A dialog that says "are you
             sure?" asks a question nobody can answer; this one says what disappears. -->
        <!-- A notice's reason is the same Secondary line (review finding B-52); its glyph says it is one. -->
        <ContentControl x:Name="ConsequenceBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Focusable="False" IsTabStop="False">
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Consequence}" />
        </ContentControl>

        <!-- Typed rather than clicked (Spec §3) for irreversible data loss. Input.Mono, not Text.Mono: that
             is a TextBlock style, and WPF refuses a style for another type the moment the window is built. -->
        <StackPanel x:Name="TypedPart" Grid.Row="2" Grid.Column="1" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock x:Name="Instruction" Margin="0,0,0,8" Style="{StaticResource Text.Label}" />
            <TextBox x:Name="Typed"
                     Style="{StaticResource Input.Mono}"
                     TextChanged="OnTyped"
                     AutomationProperties.Name="{Binding Text, ElementName=Instruction}"
                     AutomationProperties.HelpText="{Binding Consequence}" />
        </StackPanel>
        </Grid>

        </StackPanel>
        </StackPanel>

        <Border x:Name="Footer"
                Background="{DynamicResource Brush.bg.base}"
                BorderBrush="{DynamicResource Brush.border.subtle}"
                BorderThickness="0,1,0,0"
                Padding="{DynamicResource Padding.dialog-footer}">
        <!-- Review finding E-25: wherever focus starts (the phrase box, Cancel or the action), Narrator reads
             what is lost with it, as the control's help text; it read the question and "Type DISCARD to
             confirm, edit", never the consequence. -->
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="Cancel"
                    Style="{StaticResource Button.Secondary}"
                    Content="{Binding Cancel}"
                    IsCancel="True"
                    Click="OnCancel"
                    AutomationProperties.Name="{Binding Cancel}"
                    AutomationProperties.HelpText="{Binding Consequence}" />
            <Button x:Name="Confirm"
                    Margin="8,0,0,0"
                    Style="{StaticResource Button.Danger}"
                    Content="{Binding Action}"
                    Click="OnConfirm"
                    AutomationProperties.Name="{Binding Action, TargetNullValue=''}"
                    AutomationProperties.HelpText="{Binding Consequence}" />
        </StackPanel>
        </Border>
    </StackPanel>
</Window>
