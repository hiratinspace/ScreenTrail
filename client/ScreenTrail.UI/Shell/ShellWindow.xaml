<Window x:Class="ScreenTrail.UI.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
             xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:review="clr-namespace:ScreenTrail.UI.Review"
        xmlns:history="clr-namespace:ScreenTrail.UI.History"
        xmlns:settings="clr-namespace:ScreenTrail.UI.Settings"
        xmlns:shell="clr-namespace:ScreenTrail.UI.Shell"
        Title="ScreenTrail"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="680"
        Style="{StaticResource Window.Base}">
    <!-- Review finding D-15: live state on the taskbar button, the recording dot or the pause mark (drawn in
         ShellWindow.xaml.cs from the state tokens), with the status announcement as its words. -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" Description="{Binding StatusAnnouncement}" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <!-- The content area shows whatever the view model hands it, by type: a pane, or a sentence
             saying why there is none. Until 2026-09-25 it showed the pane's name. -->
        <DataTemplate DataType="{x:Type review:ReviewViewModel}">
            <review:ReviewPane />
        </DataTemplate>
        <DataTemplate DataType="{x:Type history:HistoryViewModel}">
            <history:HistoryPane />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
            <settings:SettingsPane />
        </DataTemplate>
        <!-- The sentence, as an empty state: centred, with an icon, rather than a line of small print in
             the top-left corner of an otherwise blank window. Its next step is in the sentence itself.
             Keyed and chosen by ShellContentTemplateSelector: a keyless string template here would also
             draw every button label in every pane. -->
        <DataTemplate x:Key="Shell.Message" DataType="{x:Type sys:String}">
            <StackPanel Style="{StaticResource EmptyState}">
                <Border Style="{StaticResource EmptyState.Disc}">
                    <controls:Glyph Style="{StaticResource EmptyState.Icon}" Text="{StaticResource Icon.Document}" />
                </Border>
                <TextBlock Style="{StaticResource EmptyState.Message}" Text="{Binding}" controls:LiveRegion.Setting="Polite" />
            </StackPanel>
        </DataTemplate>
        <shell:ShellContentTemplateSelector x:Key="Shell.Content" Message="{StaticResource Shell.Message}" />

        <!-- The rail's foot items. Tag="Selected" marks the view the session pane shows (Rail.FootItem). -->
        <Style x:Key="Foot.History" BasedOn="{StaticResource Rail.FootItem}" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding View}" Value="History">
                    <Setter Property="Tag" Value="Selected" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Foot.Settings" BasedOn="{StaticResource Rail.FootItem}" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding View}" Value="Settings">
                    <Setter Property="Tag" Value="Selected" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <!-- Spec §5 S4: Ctrl+F puts focus in the rail's search, from anywhere in the window. -->
        <KeyBinding Modifiers="Ctrl" Key="F" Command="{x:Static shell:ShellWindow.FindCommand}" />
        <!-- Review finding E-21: F1 opens the shortcut sheet, as "?" does, from a text box too. -->
        <KeyBinding Key="F1" Command="{x:Static shell:ShellWindow.ShortcutsCommand}" />
    </Window.InputBindings>

    <!-- Spec v0.6.0 §5 S3 and S4, as built v0.6.4: the frame (the rail, shell.bg) beside the session
         pane (bg.base). The window's own title bar carries the name, so there is no title band: the
         status chip heads the rail and the pane keeps the height. The rail comes first in the Tab
         order, then the pane. -->
    <Grid x:Name="ShellFrame" Background="{DynamicResource Brush.shell.bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The inbox rail (Spec §5 S4): the status chip, search and the groups, then its foot. -->
        <!-- Narrower in a window under layout.rail-narrow-below (code-behind, spec v0.6.9 S4), so the pane
             keeps its room at the 960 minimum, with the pane's narrow padding. -->
        <Grid x:Name="RailFrame" Grid.Column="0" Width="{DynamicResource Layout.rail-width}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- What the service says it is doing. Its own region so a screen reader is told when it
                 changes without the whole window being re-announced (Spec §7). -->
            <!-- The words are a TextBlock inside the badge, named and announced there: a ContentControl
                 has no automation peer, so a name or a live region on the badge itself reached no screen
                 reader (ST-084). -->
            <!-- On the frame (Spec §3, status chip; design system 2.3, review findings A-03, D-25, E-27): a 28 px
                 pill with a border.strong edge in every state (a red outline read as an error field), an 8 px
                 dot in the shell.* colour of the state, and the words in shell.text, since state colours are
                 indicators, not text (§2.1). One line at any width or text size: the words trim, and the time
                 sits apart in tabular figures and never trims, so the chip neither wraps nor wobbles as the
                 seconds go by. The tooltip and the name carry the whole line. -->
            <ContentControl Grid.Row="0"
                            Margin="16,12,16,4"
                            HorizontalAlignment="Left"
                            Style="{StaticResource Rail.StatusChip}"
                            ToolTip="{Binding StatusLine}">
                <DockPanel>
                    <!-- The shared StateDot, with each tone's colour on the frame. -->
                    <Ellipse Margin="0,0,8,0" DockPanel.Dock="Left">
                        <Ellipse.Style>
                            <Style BasedOn="{StaticResource StateDot}" TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Brush.shell.offline}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Recording">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.shell.recording}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Paused">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.shell.paused}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Scope">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.shell.scope}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <!-- The time: drawn, not read on its own (a Glyph has no automation peer); the words' name carries it. -->
                    <controls:Glyph x:Name="StatusTime"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Text.Numeric}"
                                    Foreground="{DynamicResource Brush.shell.text}"
                                    TextWrapping="NoWrap"
                                    Text="{Binding StatusTime}" />
                    <!-- Announced on the state without the clock, so a recording is not read out every second. -->
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Text.Frame}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Text="{Binding StatusWords}"
                               AutomationProperties.Name="{Binding StatusLine, StringFormat='Capture state: {0}'}"
                               controls:LiveRegion.Setting="Polite"
                               controls:LiveRegion.Key="{Binding StatusAnnouncement}" />
                </DockPanel>
            </ContentControl>

            <history:InboxRailView x:Name="Rail" Grid.Row="1" DataContext="{Binding Rail}" />

            <!-- The foot: every session in a table (select several to discard them, or mark one as
                 published), Settings and the diagnostics panel. 8 in on every side, so a selected item's fill
                 sits centred in the rail, and its items 2 apart (review finding A-07). -->
            <Border Grid.Row="2"
                    Padding="8"
                    BorderBrush="{DynamicResource Brush.shell.line}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <Button Style="{StaticResource Foot.History}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="History"
                            AutomationProperties.Name="All sessions"
                            AutomationProperties.HelpText="Every session in a table: select several to discard them, or one marked Not confirmed to mark it as published.">
                        <StackPanel Orientation="Horizontal">
                            <controls:Glyph Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.shell.muted}" Text="{StaticResource Icon.List}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="All sessions" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,2,0,0"
                            Style="{StaticResource Foot.Settings}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"
                            AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <controls:Glyph Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.shell.muted}" Text="{StaticResource Icon.Settings}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Settings" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,2,0,0"
                            Style="{StaticResource Rail.FootItem}"
                            Command="{Binding OpenDiagnosticsCommand}"
                            AutomationProperties.Name="Diagnostics"
                            AutomationProperties.HelpText="What's being captured, in a window of its own.">
                        <StackPanel Orientation="Horizontal">
                            <controls:Glyph Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.shell.muted}" Text="{StaticResource Icon.Diagnostic}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Diagnostics" />
                        </StackPanel>
                    </Button>
                    <!-- Review finding E-21: the shortcut sheet had no visible way in; "?" outside a text box was
                         the only one. Its row, with the "?" key cap at the right (design system 10.4). -->
                    <Button x:Name="ShortcutsItem"
                            Margin="0,2,0,0"
                            HorizontalContentAlignment="Stretch"
                            Style="{StaticResource Rail.FootItem}"
                            Command="{x:Static shell:ShellWindow.ShortcutsCommand}"
                            AutomationProperties.Name="Keyboard shortcuts"
                            AutomationProperties.AcceleratorKey="F1"
                            AutomationProperties.HelpText="Every shortcut, in a sheet of its own. F1 or ? opens it too.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:Glyph Grid.Column="0" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.shell.muted}" Text="{StaticResource Icon.Keyboard}" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Keyboard shortcuts" />
                            <Border Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource KeyCap}">
                                <TextBlock Style="{StaticResource Text.KeyHint}" Text="?" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The session pane: the open session, History's table, Settings, or a sentence saying why none. -->
        <Grid Grid.Column="1" Background="{DynamicResource Brush.bg.base}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Spec §5 S1: shown only when the service is not answering. A bar that is always there is a bar
                 nobody reads, including on the day it says something that matters. -->
            <ContentControl Grid.Row="0"
                    Margin="24,16,24,0"
                    Style="{StaticResource Banner}"
                    theme:Banner.Tone="Warning"
                    theme:Motion.FadeIn="True"
                    Visibility="{Binding BannerVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap"
                               Text="{Binding Banner}"
                               controls:LiveRegion.Setting="Assertive" />
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            Style="{StaticResource Button.Secondary}"
                            theme:Density.Compact="True"
                            Content="Start"
                            Command="{Binding StartServiceCommand}"
                            AutomationProperties.Name="Start the capture service" />
                </Grid>
            </ContentControl>

            <!-- Review finding D-26: each view's pane is built once, in a host of its own here, and the views
                 switch by visibility with a 120 ms fade on the incoming one (ShellWindow.HostPanes). One
                 ContentControl threw the whole Review pane away on every switch to All sessions and back. -->
            <Grid x:Name="Pane"
                  Grid.Row="1"
                  Margin="{DynamicResource Padding.pane}" />
        </Grid>
    </Grid>
</Window>
