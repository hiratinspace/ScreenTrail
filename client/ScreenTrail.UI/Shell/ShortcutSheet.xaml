<Window x:Class="ScreenTrail.UI.Shell.ShortcutSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:ScreenTrail.UI.Theme"
        xmlns:controls="clr-namespace:ScreenTrail.UI.Controls"
        xmlns:shell="clr-namespace:ScreenTrail.UI.Shell"
        Title="Keyboard shortcuts"
        Width="960"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}"
        Background="{DynamicResource Brush.bg.surface}"
        theme:TitleBar.Caption="Surface"
        Style="{StaticResource Window.Base}">
    <Window.Resources>
        <!-- A group's heading: the label style, as Settings' field names are, so the keys and their words
             stay the sheet's content. -->
        <Style x:Key="Sheet.GroupHeading" BasedOn="{StaticResource Text.Label}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>

        <!-- One group: its heading, then a line per chord, each key in its cap. -->
        <DataTemplate x:Key="Sheet.Group">
            <StackPanel>
                <TextBlock Style="{StaticResource Sheet.GroupHeading}" Text="{Binding Name}" />
                <controls:Repeater ItemsSource="{Binding Chords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:KeyCapList Grid.Column="0" VerticalAlignment="Top" ItemsSource="{Binding Caps}" AutomationProperties.Name="{Binding Spoken}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- The one key cap (design system 10.5, review finding B-31): alternatives are
                                                 caps 4 apart with no comma, which sat below the caps; the line is read as
                                                 one text with "or" between them (KeyCapList). -->
                                            <Border Margin="0,0,4,4" Style="{StaticResource KeyCap}">
                                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.KeyHint}" Text="{Binding Key}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:KeyCapList>
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Action}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:Repeater>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <!-- Spec §4: ? opens a shortcut sheet. Every chord Spec §5 lists, grouped by where it works. Text, not
         controls: a screen reader reads it as a document, and Esc or Close puts the technician back. Two
         columns of groups, so the whole sheet fits a 768 px screen with Close on it (ST-084). 960 wide, within
         a 1024 px screen, so most lines take one line each: at 780 the step's Del line (v0.6.8) pushed Close
         off the bottom.
         On a shorter work area (1080p at 150%, review finding D-07) the window stops at the work area less 48
         (FitToWorkArea) and the groups scroll above Close, which stays on screen. The scroll area takes focus
         from Shift+Tab, so the arrow keys and Page Down scroll it, and shows the app's focus ring when it has it
         (WPF's default dotted rectangle does not reach 3:1). -->
    <!-- Review finding D-12: the sheet is its surface, caption and body alike. -->
    <Grid Margin="{DynamicResource Padding.pane}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource Text.SectionHeading}" Text="Keyboard shortcuts" />
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="True"
                      IsTabStop="True"
                      FocusVisualStyle="{StaticResource FocusRing}"
                      AutomationProperties.Name="Shortcuts">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:Repeater Grid.Column="0" ItemsSource="{x:Static shell:ShortcutSheet.LeftColumn}" ItemTemplate="{StaticResource Sheet.Group}" />
                <controls:Repeater Grid.Column="2" ItemsSource="{x:Static shell:ShortcutSheet.RightColumn}" ItemTemplate="{StaticResource Sheet.Group}" />
            </Grid>
        </ScrollViewer>

        <Button x:Name="CloseButton"
                Grid.Row="2"
                Margin="0,24,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource Button.Secondary}"
                Content="_Close"
                IsDefault="True"
                IsCancel="True"
                Click="OnClose"
                AutomationProperties.Name="Close the shortcut sheet" />
    </Grid>
</Window>
